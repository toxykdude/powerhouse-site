# Environment template for LOCAL development (`wrangler pages dev`).
#
# Production values live in the Cloudflare Pages dashboard
# (Settings → Environment variables / D1 bindings) — NEVER commit real
# secrets to this repository.

# Cloudflare Turnstile (bot protection on the evaluation form; empty = off)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email delivery: 'gmail' sends via Gmail SMTP (app password — primary),
# 'sendgrid'/'resend' are HTTP alternatives, 'console' logs only (dev).
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (recommended on Workers); 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=powerhousegymmanizales@gmail.com
SMTP_PASSWORD=
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="PowerHouse GYM Evaluaciones"
EVALUATIONS_TO_EMAIL=support@powerhousegym.co

# Anti-abuse: salt for hashing visitor IPs (rate limiting)
RATE_LIMIT_SALT=change-me

# Admin analytics (GET /api/admin/trainer-stats); empty disables the endpoint
ADMIN_API_KEY=

# Rate limit knobs: max evaluations per IP per hour, and the duplicate
# window (minutes) per trainer per IP
EVAL_RATE_LIMIT_PER_HOUR=5
EVAL_DUPLICATE_WINDOW_MIN=15

# ---------------------------------------------------------------------------
# mipago.online payment hub (side-by-side rail with the legacy Wompi
# widget; production values live ONLY in the Cloudflare Pages dashboard)
# ---------------------------------------------------------------------------
# "true"/"1" enables POST /api/payment/mipago/create; empty keeps the
# legacy Wompi widget as the active rail
MIPAGO_ENABLED=
# Hub tenant API key (looks like ph_live_...) — server-side only
MIPAGO_API_KEY=
# Shared secret the hub uses to sign callbacks (HMAC-SHA256) — must match
# what the hub has registered for this tenant
MIPAGO_CALLBACK_SECRET=
# Optional hub base override for sandbox validation (staging URL changes
# per deploy — ask the human; empty = https://mipago.online production)
MIPAGO_API_URL=
# Optional return_url override (hub 302s back here with ?mipago=<id>
# after payment; must be https + on the tenant's allowed origins).
# Empty = https://powerhousegym.co/pago/confirmacion
MIPAGO_RETURN_URL=
# Shared secret for the reconcile cron endpoint (POST /api/payment/mipago/
# reconcile with X-Reconcile-Key) — set in GitHub Secrets as
# MIPAGO_RECONCILE_KEY for the scheduled workflow
MIPAGO_RECONCILE_KEY=
# KV namespace binding name for the payment registry + event dedup
# (bind MIPAGO_KV in the Pages dashboard; optional but recommended)
MIPAGO_KV=
