---
const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5h11M6.5 17.5h11"/><rect x="2" y="4" width="5" height="16" rx="1"/><rect x="17" y="4" width="5" height="16" rx="1"/><line x1="7" y1="12" x2="17" y2="12"/></svg>`,
    label: "Maquinas de Transito Pesado",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 2h3v20h-3z"/><path d="M15.5 6h3a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3"/><path d="M8.5 6h-3A2 2 0 0 0 3.5 8v8a2 2 0 0 0 2 2h3"/><circle cx="12" cy="12" r="0.5" fill="currentColor"/></svg>`,
    label: "Suplementacion In-House",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    label: "Sin Contratos ni Papeleo",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    label: "Entrenadores Siempre Presentes",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    label: "Horario Privilegiado (5am-10pm)",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>`,
    label: "Entrenamiento Semi-Personalizado",
  },
];

const tickerItems = [...features, ...features];
---

<div class="ticker-wrapper" aria-hidden="true">
  <div class="ticker-track">
    {tickerItems.map((item, _i) => (
      <div class="ticker-item">
        <Fragment set:html={item.icon} />
        <span class="ticker-label">{item.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
.ticker-wrapper {
  width: 100%;
  overflow: hidden;
  border-top: 1px solid var(--lighter);
  border-bottom: 1px solid var(--lighter);
  padding: 20px 0;
  background: var(--black);
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: tickerScroll 30s linear infinite;
}

.ticker-track:hover {
  animation-play-state: paused;
}

.ticker-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 40px;
  white-space: nowrap;
  color: var(--gold);
  flex-shrink: 0;
}

.ticker-item svg {
  flex-shrink: 0;
  opacity: 0.85;
}

.ticker-label {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--offwhite);
  opacity: 0.8;
}

@keyframes tickerScroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media (max-width: 768px) {
  .ticker-item {
    padding: 0 24px;
  }
  .ticker-label {
    font-size: 12px;
  }
  .ticker-item svg {
    width: 22px;
    height: 22px;
  }
}
</style>
