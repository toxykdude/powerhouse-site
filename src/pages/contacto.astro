---
import Base from "../layouts/Base.astro";
---

<Base title="Contacto y Ubicación" description="Visítanos en el Parque de la Mujer, Avenida Santander, Manizales. Lun–Vie 5am–10pm · Sáb–Dom 9am–2pm · WhatsApp +57 315 471 1900.">
	<div class="contacto-page">
		<div class="contacto-page__hero">
			<span class="contacto-page__tagline">Contacto</span>
			<h1>HABLEMOS DE TUS METAS</h1>
			<p>¿Tienes dudas? Estamos aquí para ayudarte a dar el primer paso.</p>
		</div>

		<div class="contacto-page__grid">
			<div class="contacto-page__info">
				<h2 class="contacto-page__info-title">INFORMACIÓN</h2>
				<p class="contacto-page__info-sub">Visítanos en nuestra sede o contáctanos por cualquiera de nuestros canales oficiales.</p>

				<div class="contacto-page__cards">
					<div class="contacto-page__card">
						<a href="https://www.google.com/maps/place/Power+House+GYM+Manizales/@5.0649845,-75.4998569,17z/data=!3m1!4b1!4m6!3m5!1s0x8e476fa3ce9f2f59:0x67f563eb9d19f9de!8m2!3d5.0649845!4d-75.4998569!16s%2Fg%2F11gjp3rj8m?entry=ttu&g_ep=EgoyMDI2MDQwNS4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener noreferrer" class="contacto-page__card-icon-link"><div class="contacto-page__card-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
						</div></a>
						<div>
							<h4>Sede</h4>
							<a href="https://www.google.com/maps/place/Power+House+GYM+Manizales/@5.0649845,-75.4998569,17z/data=!3m1!4b1!4m6!3m5!1s0x8e476fa3ce9f2f59:0x67f563eb9d19f9de!8m2!3d5.0649845!4d-75.4998569!16s%2Fg%2F11gjp3rj8m?entry=ttu&g_ep=EgoyMDI2MDQwNS4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener noreferrer" class="contacto-page__link">Avenida Santander, Parque de la Mujer, Manizales</a>
						</div>
					</div>
					<div class="contacto-page__card">
						<a href="https://wa.me/573154711900" target="_blank" rel="noopener noreferrer" class="contacto-page__card-icon-link"><div class="contacto-page__card-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						</div></a>
						<div>
							<h4>Teléfono</h4>
							<a href="https://wa.me/573154711900" target="_blank" rel="noopener noreferrer" class="contacto-page__link contacto-page__link--wa">+57 315 471 1900</a>
						</div>
					</div>
					<div class="contacto-page__card">
						<a href="mailto:gerencia@powerhousegym.co" class="contacto-page__card-icon-link"><div class="contacto-page__card-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
						</div></a>
						<div>
							<h4>Email</h4>
							<a href="mailto:gerencia@powerhousegym.co" class="contacto-page__link">gerencia@powerhousegym.co</a>
						</div>
					</div>
					<div class="contacto-page__card">
						<div class="contacto-page__card-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
						</div>
						<div>
							<h4>Horarios</h4>
							<p>Lun-Vie: 5am-10pm</p>
							<p>Sáb-Dom: 9am-2pm</p>
						</div>
					</div>
				</div>

				<a href="https://wa.me/573154711900" target="_blank" rel="noopener noreferrer" class="contacto-page__whatsapp-btn">
					<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
					ESCRÍBENOS POR WHATSAPP
				</a>
			</div>

			<div class="contacto-page__form-wrap">
				<h2 class="contacto-page__form-title">ENVÍANOS UN MENSAJE</h2>
				<form class="contacto-form" id="contactForm">
					<div class="contacto-form__group">
						<label for="contact-name">Nombre Completo</label>
						<input type="text" id="contact-name" name="name" placeholder="Ej: Juan Pérez" required />
					</div>
					<div class="contacto-form__group">
						<label for="contact-phone">WhatsApp / Celular</label>
						<input type="tel" id="contact-phone" name="phone" placeholder="Ej: +57 300 000 0000" required />
					</div>
					<div class="contacto-form__group">
						<label for="contact-email">Email</label>
						<input type="email" id="contact-email" name="email" placeholder="Ej: juan@email.com" required />
					</div>
					<div class="contacto-form__group">
						<label for="contact-message">Mensaje</label>
						<textarea id="contact-message" name="message" placeholder="¿En qué podemos ayudarte?" rows="6" required></textarea>
					</div>
					<button type="submit" class="contacto-form__submit">
						ENVIAR MENSAJE
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 11 13"/></svg>
					</button>
				</form>
			</div>
		</div>
	</div>
</Base>

<style>
	.contacto-page {
		padding-top: 8rem;
		padding-bottom: 6rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		background: var(--brand-black);
	}

	.contacto-page__hero {
		max-width: 80rem;
		margin: 0 auto;
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.contacto-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.contacto-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10vw, 9rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.contacto-page__hero p {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		max-width: 40rem;
	}

	.contacto-page__grid {
		max-width: 80rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: start;
	}

	.contacto-page__info {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.contacto-page__info-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--brand-white);
		text-transform: uppercase;
		letter-spacing: -0.01em;
	}

	.contacto-page__info-sub {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		line-height: 1.7;
		max-width: 28rem;
	}

	.contacto-page__cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.contacto-page__card {
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.1);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contacto-page__card-icon-link {
		text-decoration: none;
		cursor: pointer;
		}

	.contacto-page__card-icon {
		width: 3rem;
		height: 3rem;
		background: rgba(232, 200, 50, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--brand-gold);
	}

	.contacto-page__card h4 {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.contacto-page__card p {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: rgba(240, 237, 232, 0.8);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		line-height: 1.6;
	}

	.contacto-page__whatsapp-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		width: 100%;
		padding: 1.5rem;
		background: #25D366;
		color: white;
		font-family: var(--font-display);
		font-size: 1.875rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.contacto-page__whatsapp-btn:hover {
		background: white;
		color: #25D366;
	}

	.contacto-page__form-wrap {
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.1);
		padding: 3rem;
		position: relative;
		overflow: hidden;
	}

	.contacto-page__form-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		margin-bottom: 2rem;
	}

	.contacto-form {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.contacto-form__group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.contacto-form label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.contacto-form input,
	.contacto-form textarea {
		width: 100%;
		background: var(--brand-black);
		border: 1px solid rgba(240, 237, 232, 0.1);
		padding: 1rem;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--brand-white);
		outline: none;
		transition: border-color 0.3s ease;
		resize: none;
	}

	.contacto-form input::placeholder,
	.contacto-form textarea::placeholder {
		color: rgba(240, 237, 232, 0.3);
	}

	.contacto-form input:focus,
	.contacto-form textarea:focus {
		border-color: var(--brand-gold);
	}

	.contacto-form__submit {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		width: 100%;
		padding: 1.25rem;
		font-family: var(--font-display);
		font-size: 1.875rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		background: var(--brand-gold);
		color: var(--brand-black);
		border: none;
		cursor: pointer;
		transition: all 0.3s ease;
		margin-top: 1rem;
	}

	.contacto-form__submit:hover {
		transform: scale(1.02);
	}

	@media (max-width: 768px) {
		.contacto-page__grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.contacto-page__cards {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	document.getElementById('contactForm')?.addEventListener('submit', (e) => {
		e.preventDefault();
		const form = e.currentTarget as HTMLFormElement;
		const name = (form.querySelector('#contact-name') as HTMLInputElement).value.trim();
		const phone = (form.querySelector('#contact-phone') as HTMLInputElement).value.trim();
		const message = (form.querySelector('#contact-message') as HTMLTextAreaElement).value.trim();
		const text = encodeURIComponent(`Hola PowerHouse!\n\nNombre: ${name}\nTelefono: ${phone}\n\nMensaje:\n${message}`);
		window.open(`https://wa.me/573154711900?text=${text}`, '_blank');
	});
</script>
