---
import Base from "../layouts/Base.astro";

const row1 = [
	{
		name: "Membresía Mensual",
		price: "69.900",
		currency: "COP",
		period: "/mes",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: false,
		cta_label: "PAGAR AHORA",
		cta_url: "https://checkout.wompi.co/l/qe2GMd",
	},
	{
		name: "Power Pack",
		price: "140.000",
		currency: "COP",
		period: "/mes",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual", "Asesoría en alimentación", "Servicio de proteína por entreno"],
		is_featured: true,
		cta_label: "PAGAR AHORA",
		cta_url: "https://checkout.wompi.co/l/le4yA3",
	},
	{
		name: "Plan Trimestral",
		price: "186.000",
		currency: "COP",
		period: "/trimestre",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: false,
		cta_label: "PAGAR AHORA",
		cta_url: "https://checkout.wompi.co/l/r3twSU",
	},
];

const row2 = [
	{
		name: "Plan Semestral",
		price: "360.000",
		currency: "COP",
		period: "/semestre",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: false,
		cta_label: "PAGAR AHORA",
		cta_url: "https://checkout.wompi.co/l/fqIPpU",
	},
	{
		name: "Plan Anual",
		price: "620.000",
		currency: "COP",
		period: "/año",
		features: ["Mejor precio beneficio, mes a $51mil!", "Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: true,
		featured_variant: "annual",
		cta_label: "PAGAR AHORA",
		cta_url: "https://checkout.wompi.co/l/bMy0aE",
	},
];

const plans = [...row1, ...row2];
---

<Base title="Planes y Membresías" description="Planes de gimnasio en Manizales desde $9.900 COP sin contrato ni permanencia. Mensual, quincenal y diario. Entrenamiento semipersonalizado incluido. ¡Inscríbete hoy!">
	<div class="planes-page">
		<div class="planes-page__hero">
			<span class="planes-page__tagline">Membresías</span>
			<h1>ELIGE TU PODER</h1>
			<p>Planes diseñados para cada nivel de compromiso. Sin contratos a largo plazo, solo resultados.</p>
		</div>

		<div class="plans-sections">
			<div class="plans-grid plans-grid--3">
				{row1.map((plan) => (
					<div class={`plan-card ${plan.is_featured ? "plan-card--featured" : ""}`}>
						{plan.is_featured && (
							<div class="plan-card__badge">RECOMENDADO</div>
						)}
						<div class="plan-card__header">
							<h3>{plan.name}</h3>
							<div class="plan-card__price">
								<span class="plan-card__currency">{plan.currency}</span>
								<span class="plan-card__amount">${plan.price}</span>
								<span class="plan-card__period">{plan.period}</span>
							</div>
						</div>
						<ul class="plan-card__features">
							{plan.features.map((feature) => (
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
									{feature}
								</li>
							))}
						</ul>
						<a
							href={plan.cta_url}
							target="_blank"
							rel="noopener noreferrer"
							class={`plan-card__cta ${plan.is_featured ? "plan-card__cta--dark" : "plan-card__cta--gold"}`}
						>
							{plan.cta_label}
						</a>
					</div>
				))}
			</div>

			<div class="plans-grid plans-grid--2">
				{row2.map((plan) => (
					<div class={`plan-card ${plan.featured_variant === "annual" ? "plan-card--annual" : plan.is_featured ? "plan-card--featured" : ""}`}>
						{plan.featured_variant === "annual" && (
							<div class="plan-card__badge plan-card__badge--gold">MEJOR VALOR</div>
						)}
						<div class="plan-card__header">
							<h3>{plan.name}</h3>
							<div class="plan-card__price">
								<span class="plan-card__currency">{plan.currency}</span>
								<span class="plan-card__amount">${plan.price}</span>
								<span class="plan-card__period">{plan.period}</span>
							</div>
						</div>
						<ul class="plan-card__features">
							{plan.features.map((feature) => (
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
									{feature}
								</li>
							))}
						</ul>
						<a
							href={plan.cta_url}
							target="_blank"
							rel="noopener noreferrer"
							class={`plan-card__cta ${plan.featured_variant === "annual" ? "plan-card__cta--gold" : plan.is_featured ? "plan-card__cta--dark" : "plan-card__cta--gold"}`}
						>
							{plan.cta_label}
						</a>
					</div>
				))}
			</div>
		</div>

		<section class="signup-section" id="signup-form">
			<div class="signup-section__inner">
				<h2>INICIA TU TRANSFORMACIÓN</h2>
				<form class="signup-form" id="signupForm">
					<div class="signup-form__row">
						<div class="signup-form__group">
							<label for="signup-name">Nombre Completo</label>
							<input type="text" id="signup-name" name="name" placeholder="Ej: Juan Pérez" required />
						</div>
						<div class="signup-form__group">
							<label for="signup-phone">WhatsApp / Celular</label>
							<input type="tel" id="signup-phone" name="phone" placeholder="Ej: +57 300 000 0000" required />
						</div>
					</div>
					<div class="signup-form__row">
						<div class="signup-form__group">
							<label for="signup-email">Email</label>
							<input type="email" id="signup-email" name="email" placeholder="Ej: juan@email.com" required />
						</div>
						<div class="signup-form__group">
							<label for="signup-plan">Plan de Interés</label>
							<select id="signup-plan" name="plan" required>
								<option value="" disabled>Selecciona un plan</option>
								{plans.map(p => (
									<option value={p.name}>{p.name} - ${p.price}</option>
								))}
							</select>
						</div>
					</div>
					<div class="signup-form__group signup-form__group--full">
						<label for="signup-message">Mensaje (Opcional)</label>
						<textarea id="signup-message" name="message" placeholder="Cuéntanos tus objetivos..." rows="4"></textarea>
					</div>
					<button type="submit" class="signup-form__submit">
						ENVIAR Y CONTACTAR POR WHATSAPP
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</button>
				</form>
			</div>
		</section>
	</div>
</Base>

<style>
	.planes-page {
		padding-top: 8rem;
		padding-bottom: 6rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		background: var(--brand-black);
	}

	.planes-page__hero {
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.planes-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.planes-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10vw, 9rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.planes-page__hero p {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		max-width: 40rem;
	}

	.plans-sections {
		max-width: 80rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-bottom: 8rem;
	}

	.plans-grid {
		display: grid;
		gap: 1.5rem;
	}

	.plans-grid--3 {
		grid-template-columns: repeat(3, 1fr);
		max-width: 80rem;
		margin: 0 auto;
	}

	.plans-grid--2 {
		grid-template-columns: repeat(2, 1fr);
		max-width: 52rem;
		margin: 0 auto;
	}

	.plan-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid rgba(232, 200, 50, 0.2);
		background: #0a0a0a;
		color: var(--brand-white);
		transition: all 0.5s ease;
	}

	.plan-card:hover {
		border-color: rgba(232, 200, 50, 0.5);
	}

	.plan-card--featured {
		background: var(--brand-gold);
		color: var(--brand-black);
		border-color: var(--brand-gold);
		transform: scale(1.05);
		z-index: 1;
		box-shadow: 0 0 50px rgba(232, 200, 50, 0.2);
	}

	.plan-card--featured:hover {
		border-color: var(--brand-gold);
	}

	.plan-card--annual {
		background: transparent;
		color: var(--brand-white);
		border: 2px solid var(--brand-gold);
		transform: scale(1.05);
		z-index: 1;
		box-shadow: 0 0 60px rgba(232, 200, 50, 0.15), inset 0 0 30px rgba(232, 200, 50, 0.05);
	}

	.plan-card--annual:hover {
		border-color: white;
		box-shadow: 0 0 80px rgba(232, 200, 50, 0.25), inset 0 0 30px rgba(232, 200, 50, 0.1);
	}

	.plan-card__badge--gold {
		background: var(--brand-gold);
		color: var(--brand-black);
		font-weight: bold;
	}

	.plan-card__badge {
		position: absolute;
		top: -1rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--brand-red);
		color: white;
		font-family: var(--font-display);
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		padding: 0.25rem 1rem;
	}

	.plan-card__header {
		margin-bottom: 1.5rem;
	}

	.plan-card__header h3 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		margin-bottom: 0.5rem;
	}

	.plan-card__price {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
	}

	.plan-card__currency {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		opacity: 0.6;
	}

	.plan-card__amount {
		font-family: var(--font-display);
		font-size: 3rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.plan-card__period {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		opacity: 0.6;
	}

	.plan-card__features {
		list-style: none;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.plan-card__features li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.plan-card__features svg {
		flex-shrink: 0;
		margin-top: 2px;
	}

	.plan-card--featured .plan-card__features svg {
		color: var(--brand-black);
	}

	.plan-card:not(.plan-card--featured) .plan-card__features svg {
		color: var(--brand-gold);
	}

	.plan-card__cta {
		display: block;
		width: 100%;
		padding: 1rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		border: none;
		cursor: pointer;
		transition: all 0.3s ease;
		text-decoration: none;
		text-align: center;
	}

	.plan-card__cta--gold {
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.plan-card__cta--gold:hover {
		background: white;
	}

	.plan-card__cta--dark {
		background: var(--brand-black);
		color: var(--brand-gold);
	}

	.plan-card__cta--dark:hover {
		background: var(--brand-red);
		color: white;
	}

	.signup-section {
		max-width: 56rem;
		margin: 0 auto;
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.2);
		padding: 3rem;
		position: relative;
		overflow: hidden;
	}

	.signup-section__inner {
		position: relative;
		z-index: 1;
	}

	.signup-section h2 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		text-align: center;
		margin-bottom: 2rem;
	}

	.signup-form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.signup-form__group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.signup-form__group--full {
		grid-column: 1 / -1;
	}

	.signup-form__label,
	.signup-form label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.signup-form input,
	.signup-form select,
	.signup-form textarea {
		width: 100%;
		background: var(--brand-black);
		border: 1px solid rgba(240, 237, 232, 0.1);
		padding: 1rem;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--brand-white);
		outline: none;
		transition: border-color 0.3s ease;
		-webkit-appearance: none;
		appearance: none;
	}

	.signup-form input::placeholder,
	.signup-form textarea::placeholder {
		color: rgba(240, 237, 232, 0.3);
	}

	.signup-form input:focus,
	.signup-form select:focus,
	.signup-form textarea:focus {
		border-color: var(--brand-gold);
	}

	.signup-form select option {
		background: var(--brand-black);
		color: var(--brand-white);
	}

	.signup-form textarea {
		resize: none;
		height: 8rem;
	}

	.signup-form__submit {
		grid-column: 1 / -1;
		width: 100%;
		padding: 1.25rem;
		font-family: var(--font-display);
		font-size: 1.875rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		background: var(--brand-gold);
		color: var(--brand-black);
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		transition: all 0.3s ease;
		margin-top: 1rem;
	}

	.signup-form__submit:hover {
		transform: scale(1.02);
	}

	@media (max-width: 768px) {
		.plans-grid--3,
		.plans-grid--2 {
			grid-template-columns: 1fr;
			max-width: 28rem;
		}

		.plan-card--featured,
		.plan-card--annual {
			transform: none;
			order: -1;
		}

		.signup-form {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	document.getElementById('signupForm')?.addEventListener('submit', (e) => {
		e.preventDefault();
		const form = e.currentTarget as HTMLFormElement;
		const name = (form.querySelector('#signup-name') as HTMLInputElement).value.trim();
		const phone = (form.querySelector('#signup-phone') as HTMLInputElement).value.trim();
		const plan = (form.querySelector('#signup-plan') as HTMLSelectElement).value;
		const message = (form.querySelector('#signup-message') as HTMLTextAreaElement).value.trim();
		const text = encodeURIComponent(`Hola PowerHouse! Me interesa el ${plan}. Mi nombre es ${name}.${message ? ' ' + message : ''}`);
		window.open(`https://wa.me/573154711900?text=${text}`, '_blank');
	});
</script>
