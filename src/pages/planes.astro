---
import Base from "../layouts/Base.astro";
import PlanCard from "../components/PlanCard.astro";

interface PlanRow {
	name: string;
	planId: string;
	price: string;
	currency: string;
	period: string;
	features: string[];
	is_featured: boolean;
	cta_label: string;
	/** When set, card shows a muted "Total $X" line under the hero (per-month) price. */
	total_price?: string;
}

// Order is intentional: Anual sits in position 2 as the highlighted RECOMENDADO card.
const plans: PlanRow[] = [
	{
		name: "Membresía Mensual",
		planId: "mensual",
		price: "69.900",
		currency: "COP",
		period: "/mes",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: false,
		cta_label: "PAGAR AHORA",
	},
	{
		name: "Plan Anual",
		planId: "anual",
		price: "51.000",
		currency: "COP",
		period: "/mes",
		total_price: "620.000",
		features: ["Mejor relación precio-beneficio", "Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: true,
		cta_label: "PAGAR AHORA",
	},
	{
		name: "Plan Trimestral",
		planId: "trimestral",
		price: "65.000",
		currency: "COP",
		period: "/mes",
		total_price: "195.000",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: false,
		cta_label: "PAGAR AHORA",
	},
	{
		name: "Plan Semestral",
		planId: "semestral",
		price: "62.500",
		currency: "COP",
		period: "/mes",
		total_price: "375.000",
		features: ["Asiste todos los días", "Entrenamiento semipersonalizado", "Valoración mensual"],
		is_featured: false,
		cta_label: "PAGAR AHORA",
	},
];
---

<Base title="Planes y Membresías" description="Planes de gimnasio en Manizales desde $51.000/mes sin permanencia. Mensual, trimestral, semestral y anual con entrenamiento semipersonalizado incluido. ¡Inscríbete hoy!">

	<div class="planes-page">
		<div class="planes-page__hero">
			<span class="planes-page__tagline">Elige tu poder</span>
			<h1>Planes y Membresías de Gimnasio en Manizales</h1>
			<p>Planes diseñados para cada nivel de compromiso. Sin contratos a largo plazo, solo resultados. Entrenamiento semipersonalizado incluido en todas las membresías.</p>
		</div>

		<div class="plans-sections">
			<div class="plans-grid plans-grid--4">
				{plans.map((plan) => (
					<PlanCard
						name={plan.name}
						price={plan.price}
						currency={plan.currency}
						period={plan.period}
						totalPrice={plan.total_price}
						features={plan.features}
						isFeatured={plan.is_featured}
						cta={{ type: "button", planId: plan.planId, label: plan.cta_label }}
					/>
				))}
			</div>
		</div>

		<section class="planes-info">
			<div class="planes-info__inner">
				<h2>Qué Incluye tu Membresía</h2>
				<div class="planes-info__grid">
					<div class="planes-info__item">
						<h3>Entrenamiento semipersonalizado</h3>
						<p>Seguimiento constante de entrenadores certificados en cada sesión. No entrenas solo: corrigen tu técnica y ajustan tu rutina.</p>
					</div>
					<div class="planes-info__item">
						<h3>Acceso todos los días</h3>
						<p>Lunes a viernes de 5:00am a 10:00pm, sábados y domingos de 9:00am a 2:00pm. Máquinas de tráfico pesado y zona de cardio con vista a la ciudad.</p>
					</div>
					<div class="planes-info__item">
						<h3>Valoración mensual</h3>
						<p>Medición de progreso cada mes: composición corporal, fuerza y ajustes de plan. Incluida en todas las membresías.</p>
					</div>
					<div class="planes-info__item">
						<h3>Sin contrato ni permanencia</h3>
						<p>Ningún plan exige cláusulas, documentos o permanencia. Hay planes quincenales desde $9.900 para probar el gimnasio.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="planes-faq">
			<div class="planes-faq__inner">
				<h2>Preguntas Frecuentes sobre Planes y Precios</h2>
				<details>
					<summary>¿Cuánto cuesta el gimnasio PowerHouse en Manizales?</summary>
					<p>La membresía mensual cuesta $69.900 COP, el plan anual $51.000/mes ($620.000 total), el trimestral $65.000/mes y el semestral $62.500/mes. También hay planes quincenales desde $9.900 COP. Sin contratos ni documentos.</p>
				</details>
				<details>
					<summary>¿PowerHouse Gym tiene contrato o permanencia?</summary>
					<p>No. No exigimos contratos, documentos ni cláusulas de permanencia. Puedes inscribirte y cancelar cuando quieras.</p>
				</details>
				<details>
					<summary>¿Qué incluye el entrenamiento?</summary>
					<p>Entrenamiento semipersonalizado con seguimiento de entrenadores certificados, equipos de tráfico pesado, zona de cardio con vista a la ciudad, valoración mensual y asesoría en nutrición y suplementación.</p>
				</details>
				<details>
					<summary>¿Dónde queda PowerHouse Gym y cuál es el horario?</summary>
					<p>Avenida Santander, Parque de la Mujer, Manizales. Horario: lunes a viernes 5:00am–10:00pm, sábados y domingos 9:00am–2:00pm.</p>
				</details>
				<details>
					<summary>¿Cómo me inscribo?</summary>
					<p>Escribe por WhatsApp al +57 315 471 1900, llámanos o usa el formulario de esta página. Agenda una clase o valoración gratis antes de decidir.</p>
				</details>
			</div>
		</section>

		<section class="signup-section" id="signup-form">
			<div class="signup-section__inner">
				<h2>INICIA TU TRANSFORMACIÓN</h2>
				<form class="signup-form" id="signupForm">
					<div class="signup-form__row">
						<div class="signup-form__group">
							<label for="signup-name">Nombre Completo</label>
							<input type="text" id="signup-name" name="name" placeholder="Ej: Juan Pérez" required />
						</div>
						<div class="signup-form__group">
							<label for="signup-phone">WhatsApp / Celular</label>
							<input type="tel" id="signup-phone" name="phone" placeholder="Ej: +57 300 000 0000" required />
						</div>
					</div>
					<div class="signup-form__row">
						<div class="signup-form__group">
							<label for="signup-email">Email</label>
							<input type="email" id="signup-email" name="email" placeholder="Ej: juan@email.com" required />
						</div>
						<div class="signup-form__group">
							<label for="signup-plan">Plan de Interés</label>
							<select id="signup-plan" name="plan" required>
								<option value="" disabled>Selecciona un plan</option>
								{plans.map(p => (
									<option value={p.name}>{p.name} — ${p.total_price ?? p.price}</option>
								))}
							</select>
						</div>
					</div>
					<div class="signup-form__group signup-form__group--full">
						<label for="signup-message">Mensaje (Opcional)</label>
						<textarea id="signup-message" name="message" placeholder="Cuéntanos tus objetivos..." rows="4"></textarea>
					</div>
					<button type="submit" class="signup-form__submit">
						ENVIAR Y CONTACTAR POR WHATSAPP
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</button>
				</form>
			</div>
		</section>
	</div>
</Base>

<style>
	.planes-info,
	.planes-faq {
		max-width: 1100px;
		margin: 0 auto 4rem;
		padding: 0 1.5rem;
	}

	.planes-info__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.planes-info__item {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.planes-info__item h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
	}

	.planes-info__item p {
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		line-height: 1.55;
		font-size: 0.95rem;
	}

	.planes-faq details {
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 1rem 1.25rem;
		margin-top: 0.75rem;
		background: rgba(255, 255, 255, 0.03);
	}

	.planes-faq summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 1.05rem;
	}

	.planes-faq details p {
		margin: 0.75rem 0 0;
		color: rgba(255, 255, 255, 0.72);
		line-height: 1.55;
	}

	.planes-page {
		padding-top: 8rem;
		padding-bottom: 6rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		background: var(--brand-black);
	}

	.planes-page__hero {
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.planes-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.planes-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10vw, 9rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.planes-page__hero p {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		max-width: 40rem;
	}

	.plans-sections {
		max-width: 80rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-bottom: 8rem;
	}

	.plans-grid {
		display: grid;
		gap: 1.5rem;
	}

	.plans-grid--3 {
		grid-template-columns: repeat(3, 1fr);
		max-width: 80rem;
		margin: 0 auto;
	}

	.plans-grid--2 {
		grid-template-columns: repeat(2, 1fr);
		max-width: 52rem;
		margin: 0 auto;
	}

	.plans-grid--4 {
		grid-template-columns: repeat(4, 1fr);
		max-width: 80rem;
		margin: 0 auto;
	}

	/* plan-card* rules moved into PlanCard.astro scoped <style>. */

	.signup-section {
		max-width: 56rem;
		margin: 0 auto;
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.2);
		padding: 3rem;
		position: relative;
		overflow: hidden;
	}

	.signup-section__inner {
		position: relative;
		z-index: 1;
	}

	.signup-section h2 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		text-align: center;
		margin-bottom: 2rem;
	}

	.signup-form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.signup-form__group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.signup-form__group--full {
		grid-column: 1 / -1;
	}

	.signup-form__label,
	.signup-form label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.signup-form input,
	.signup-form select,
	.signup-form textarea {
		width: 100%;
		background: var(--brand-black);
		border: 1px solid rgba(240, 237, 232, 0.1);
		padding: 1rem;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--brand-white);
		outline: none;
		transition: border-color 0.3s ease;
		-webkit-appearance: none;
		appearance: none;
	}

	.signup-form input::placeholder,
	.signup-form textarea::placeholder {
		color: rgba(240, 237, 232, 0.3);
	}

	.signup-form input:focus,
	.signup-form select:focus,
	.signup-form textarea:focus {
		border-color: var(--brand-gold);
	}

	.signup-form select option {
		background: var(--brand-black);
		color: var(--brand-white);
	}

	.signup-form textarea {
		resize: none;
		height: 8rem;
	}

	.signup-form__submit {
		grid-column: 1 / -1;
		width: 100%;
		padding: 1.25rem;
		font-family: var(--font-display);
		font-size: 1.875rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		background: var(--brand-gold);
		color: var(--brand-black);
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		transition: all 0.3s ease;
		margin-top: 1rem;
	}

	.signup-form__submit:hover {
		transform: scale(1.02);
	}

	@media (max-width: 768px) {
		.plans-grid--3,
		.plans-grid--2,
		.plans-grid--4 {
			grid-template-columns: 1fr;
			max-width: 28rem;
		}

		/* plan-card--featured/--annual responsive rules moved into PlanCard.astro. */

		.signup-form {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// WhatsApp signup form handler
	document.getElementById('signupForm')?.addEventListener('submit', (e) => {
		e.preventDefault();
		const form = e.currentTarget as HTMLFormElement;
		const name = (form.querySelector('#signup-name') as HTMLInputElement).value.trim();
		const _phone = (form.querySelector('#signup-phone') as HTMLInputElement).value.trim();
		const plan = (form.querySelector('#signup-plan') as HTMLSelectElement).value;
		const message = (form.querySelector('#signup-message') as HTMLTextAreaElement).value.trim();
		const text = encodeURIComponent(`Hola PowerHouse! Me interesa el ${plan}. Mi nombre es ${name}.${message ? ' ' + message : ''}`);
		window.open(`https://wa.me/573154711900?text=${text}`, '_blank');
	});
</script>

<script>
	// Guest checkout CTA — gym plans route to /comprar where identity is
	// captured and the pending record is stored before the Wompi widget
	// opens. No amounts are authored here.
	document.querySelectorAll<HTMLButtonElement>('[data-plan-id]').forEach((button) => {
		button.addEventListener('click', () => {
			const planId = button.dataset.planId;
			if (!planId) return;
			window.location.href = '/comprar?plan=' + encodeURIComponent(planId);
		});
	});
</script>
