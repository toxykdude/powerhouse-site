---
import Base from "../layouts/Base.astro";

const facilities = [
	{ name: "Musculación", icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5h11M6.5 17.5h11"/><rect x="2" y="4" width="5" height="16" rx="1"/><rect x="17" y="4" width="5" height="16" rx="1"/><line x1="7" y1="12" x2="17" y2="12"/></svg>' },
	{ name: "Funcional", icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>' },
	{ name: "Cardiovascular", icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' },
	{ name: "Olympic Plates", icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>' },
	{ name: "Full Dumbbell Rack", icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5h11M6.5 17.5h11"/><rect x="2" y="4" width="5" height="16" rx="1"/><rect x="17" y="4" width="5" height="16" rx="1"/><line x1="7" y1="12" x2="17" y2="12"/></svg>' },
];
---

<Base title="Quiénes Somos" description="Conoce al equipo de entrenadores certificados de PowerHouse Gym Manizales. 16+ años de experiencia en fisiculturismo, biomecánica y entrenamiento deportivo. ¡Visítanos en Avenida Santander!">
	<div class="nosotros-page">
		<div class="nosotros-page__hero">
			<span class="nosotros-page__tagline">Nuestra Historia</span>
			<h1>MÁS QUE UN GYM</h1>
			<p>Un espacio diseñado para la excelencia física y mental en el corazón de Manizales.</p>
		</div>

		<div class="story-section">
			<div class="story-section__inner">
				<div class="story-section__image">
					<div class="story-section__image-wrap">
						<img
							src="https://images.unsplash.com/photo-1540497077202-7c8a3999166f?q=80&w=2070&auto=format&fit=crop"
							alt="Gym Equipment"
							referrerpolicy="no-referrer"
						/>
					</div>
					<div class="story-section__badge">HIERRO REAL</div>
				</div>
				<div class="story-section__text">
					<h2 class="section-title">NUESTRO ORIGEN</h2>
					<p class="story-section__headline">PowerHouse Gym nació de la necesidad de un espacio de entrenamiento <span class="story-section__accent">puro</span>.</p>
					<p>En una era de gimnasios corporativos y máquinas de plástico, decidimos volver a las raíces. Máquinas de tráfico pesado, discos olímpicos y una comunidad que se apoya mutuamente para alcanzar su máximo potencial.</p>
					<p>Nuestro enfoque semi-personalizado garantiza que nunca estés solo en tu proceso. Siempre habrá un experto guiando tu técnica y motivándote a dar ese 1% extra cada día.</p>
				</div>
			</div>
		</div>

		<div class="facilities-section">
			<h2 class="section-title facilities-section__title">INSTALACIONES</h2>
			<div class="facilities-grid">
				{facilities.map((f) => (
					<div class="facility-card">
						<div class="facility-card__icon" set:html={f.icon} />
						<span class="facility-card__name">{f.name}</span>
					</div>
				))}
			</div>
		</div>

		<div class="video-section">
			<div class="video-section__inner">
				<h2 class="section-title">CONOCÉ NUESTRA UBICACIÓN</h2>
				<div class="video-section__wrapper">
					<iframe
						width="560"
						height="315"
						src="https://www.youtube.com/embed/NWp4nPn79UI?si=cCu3nFzMGs2_3cVt"
						title="PowerHouse Gym Manizales - Ubicación"
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
						loading="lazy"
					></iframe>
				</div>
			</div>
		</div>

		<div class="location-section">
			<div class="location-section__inner">
				<div class="location-section__info">
					<h2 class="section-title">ENCUÉNTRANOS</h2>
					<div class="location-section__details">
						<div class="location-section__item">
							<div class="location-section__item-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
							</div>
							<div>
								<h4>Ubicación</h4>
								<p>Avenida Santander, Parque de la Mujer, Manizales, Colombia</p>
							</div>
						</div>
						<div class="location-section__item">
							<div class="location-section__item-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
							</div>
							<div>
								<h4>Horarios</h4>
								<p>Lun – Vie: <span class="location-section__gold">5:00am – 10:00pm</span></p>
								<p>Sáb – Dom: <span class="location-section__gold">9:00am – 2:00pm</span></p>
							</div>
						</div>
						<div class="location-section__item">
							<div class="location-section__item-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							</div>
							<div>
								<h4>Teléfono</h4>
								<p>+57 315 471 1900</p>
							</div>
						</div>
					</div>
				</div>
				<div class="location-section__map">
					<iframe
						src="https://maps.google.com/maps?q=Power+House+GYM+Manizales/@5.0649845,-75.4998569&z=18&output=embed&iwloc=near"
						title="PowerHouse Gym - Manizales, Caldas"
						loading="lazy"
						allowfullscreen
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</div>
	</div>
</Base>

<style>
	.nosotros-page {
		padding-top: 8rem;
		padding-bottom: 6rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		background: var(--brand-black);
	}

	.nosotros-page__hero {
		max-width: 80rem;
		margin: 0 auto;
		text-align: center;
		margin-bottom: 6rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.nosotros-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.nosotros-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10vw, 9rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.nosotros-page__hero p {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		max-width: 40rem;
	}

	.story-section {
		max-width: 80rem;
		margin: 0 auto 8rem;
	}

	.story-section__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: center;
	}

	.story-section__image {
		position: relative;
	}

	.story-section__image-wrap {
		aspect-ratio: 1;
		border: 1px solid rgba(232, 200, 50, 0.2);
		overflow: hidden;
		background: rgba(232, 200, 50, 0.1);
	}

	.story-section__image-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
		opacity: 0.8;
		transition: transform 0.7s ease;
	}

	.story-section__image-wrap:hover img {
		transform: scale(1.1);
	}

	.story-section__badge {
		position: absolute;
		bottom: -2.5rem;
		right: -2.5rem;
		background: var(--brand-gold);
		color: var(--brand-black);
		font-family: var(--font-display);
		font-size: 3rem;
		padding: 3rem;
	}

	.story-section__text {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.story-section__headline {
		font-family: var(--font-mono);
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		color: var(--brand-white);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		line-height: 1.6;
	}

	.story-section__accent {
		color: var(--brand-gold);
	}

	.story-section__text p:last-of-type {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		line-height: 1.7;
	}

	.story-section__text p:nth-of-type(2) {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		line-height: 1.7;
	}

	.facilities-section {
		max-width: 80rem;
		margin: 0 auto 8rem;
	}

	.facilities-section__title {
		text-align: center;
		margin-bottom: 4rem;
	}

	.facilities-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 2rem;
	}

	.facility-card {
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.1);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		transition: all 0.3s ease;
	}

	.facility-card:hover {
		border-color: var(--brand-gold);
	}

	.facility-card__icon {
		width: 4rem;
		height: 4rem;
		background: rgba(232, 200, 50, 0.05);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--brand-gold);
		transition: all 0.3s ease;
	}

	.facility-card:hover .facility-card__icon {
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.facility-card__name {
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--brand-white);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.video-section {
		max-width: 80rem;
		margin: 0 auto;
		padding-bottom: 4rem;
	}

	.video-section__inner {
		text-align: center;
	}

	.video-section__wrapper {
		position: relative;
		width: 100%;
		max-width: 56rem;
		margin: 2rem auto 0;
		aspect-ratio: 16 / 9;
		border: 1px solid rgba(232, 200, 50, 0.2);
		overflow: hidden;
	}

	.video-section__wrapper iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: none;
	}

	.location-section {
		max-width: 80rem;
		margin: 0 auto;
	}

	.location-section__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.location-section__info {
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.1);
		padding: 3rem;
	}

	.location-section__details {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-top: 2rem;
	}

	.location-section__item {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.location-section__item-icon {
		width: 3rem;
		height: 3rem;
		background: rgba(232, 200, 50, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--brand-gold);
		flex-shrink: 0;
	}

	.location-section__item h4 {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		margin-bottom: 0.5rem;
	}

	.location-section__item p {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: rgba(240, 237, 232, 0.8);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		line-height: 1.6;
	}

	.location-section__gold {
		color: var(--brand-gold);
	}

	.location-section__map {
		height: 500px;
		min-height: 500px;
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.1);
		overflow: hidden;
		position: relative;
	}

	.location-section__map iframe {
		width: 100%;
		height: 100%;
		border: 0;
		filter: grayscale(1) invert(1) contrast(1.2);
		position: relative;
		z-index: 1;
	}

	@media (max-width: 1024px) {
		.facilities-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 768px) {
		.story-section__inner {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.story-section__badge {
			display: none;
		}

		.facilities-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.location-section__inner {
			grid-template-columns: 1fr;
		}

		.location-section__map {
			min-height: 350px;
			height: 350px;
		}
	}
</style>
