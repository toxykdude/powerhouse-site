---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

function formatDate(dateStr: string | Date): string {
	const d = typeof dateStr === "string" ? new Date(dateStr) : dateStr;
	return d.toLocaleDateString("es-CO", { year: "numeric", month: "long", day: "numeric" });
}

/**
 * Resolve featured_image which can be a string URL or a JSON object {src: "..."}.
 */
function resolveImageUrl(img: any): string {
	if (!img) return "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=800&auto=format&fit=crop";
	if (typeof img === "string") return img;
	if (typeof img === "object" && img !== null && img.src) return img.src;
	return String(img);
}
const categories = ["Todos", "Nutrición", "Entrenamiento", "Motivación", "Suplementación"];
---

<Base title="Blog de Entrenamiento y Nutrición" description="Artículos sobre entrenamiento, nutrición, suplementación y motivación para alcanzar tu mejor versión. Escritos por expertos de PowerHouse Gym Manizales.">
	<div class="blog-page">
		<div class="blog-page__hero">
			<span class="blog-page__tagline">Contenido Elite</span>
			<h1>POWER BLOG</h1>
			<p>Consejos de expertos para potenciar tu rendimiento y mentalidad.</p>
		</div>

		<div class="blog-page__filters" id="blogFilters">
			<div class="blog-page__categories">
				{categories.map((cat) => (
					<button class={`blog-page__cat-btn ${cat === "Todos" ? "blog-page__cat-btn--active" : ""}`} data-category={cat}>
						{cat}
					</button>
				))}
			</div>
			<div class="blog-page__search">
				<svg class="blog-page__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				<input type="text" id="blogSearch" placeholder="BUSCAR ARTICULO..." />
			</div>
		</div>

		{posts && posts.length > 0 ? (
			<div class="blog-page__grid" id="blogGrid">
				{posts.map((post: any) => {
					const title = post.data.title || "";
					const category = post.data.category || "";
					const date = post.data.date;
				const featuredImage = resolveImageUrl(post.data.featuredImage);
					const slug = post.data.slug;
					const excerpt = post.data.excerpt || "";
					const searchBody = excerpt.toLowerCase();

					return (
						<article class="blog-card" data-category={category} data-title={title.toLowerCase()} data-body={searchBody}>
							<div class="blog-card__image">
								<img src={featuredImage} alt={title} width="800" height="450" loading="lazy" referrerpolicy="no-referrer" />
								<div class="blog-card__image-gradient"></div>
								<div class="blog-card__category-badge">{category || "General"}</div>
							</div>
							<div class="blog-card__body">
								<div class="blog-card__meta">
									<span class="blog-card__date">{date ? formatDate(date) : ""}</span>
									<span class="blog-card__cat-label">{category || "General"}</span>
								</div>
								<h3 class="blog-card__title">{title}</h3>
								<p class="blog-card__excerpt">{excerpt}...</p>
								<a href={`/blog/${slug}`} class="blog-card__link">
									LEER MAS
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
								</a>
							</div>
						</article>
					);
				})}
			</div>
		) : (
			<div class="blog-page__empty">
				<h3>No se encontraron articulos</h3>
				<p>Proximamente publicaremos contenido para ti.</p>
				<p style="color: rgba(240, 237, 232, 0.4); font-size: 0.875rem;">Mientras tanto, visita nuestras redes sociales.</p>
			</div>
		)}
	</div>
</Base>

<style>
	.blog-page {
		padding-top: 8rem;
		padding-bottom: 6rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		background: var(--brand-black);
	}

	.blog-page__hero {
		max-width: 80rem;
		margin: 0 auto;
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.blog-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.blog-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10vw, 9rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.blog-page__hero p {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		max-width: 40rem;
	}

	.blog-page__filters {
		max-width: 80rem;
		margin: 0 auto 4rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid rgba(232, 200, 50, 0.1);
		flex-wrap: wrap;
	}

	.blog-page__categories {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
	}

	.blog-page__cat-btn {
		padding: 0.5rem 1.5rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		border: none;
		cursor: pointer;
		transition: all 0.3s ease;
		background: transparent;
		color: rgba(240, 237, 232, 0.6);
	}

	.blog-page__cat-btn:hover {
		color: var(--brand-gold);
	}

	.blog-page__cat-btn--active {
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.blog-page__search {
		position: relative;
		width: 100%;
		max-width: 24rem;
	}

	.blog-page__search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: rgba(232, 200, 50, 0.5);
	}

	.blog-page__search input {
		width: 100%;
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.2);
		padding: 1rem 1rem 1rem 3rem;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-white);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		outline: none;
		transition: border-color 0.3s ease;
	}

	.blog-page__search input::placeholder {
		color: rgba(240, 237, 232, 0.3);
	}

	.blog-page__search input:focus {
		border-color: var(--brand-gold);
	}

	.blog-page__grid {
		max-width: 80rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 3rem;
	}

	.blog-card {
		display: flex;
		flex-direction: column;
		background: #0a0a0a;
		border: 1px solid rgba(232, 200, 50, 0.1);
		overflow: hidden;
		transition: all 0.5s ease;
	}

	.blog-card:hover {
		border-color: rgba(232, 200, 50, 0.5);
		transform: translateY(-5px);
	}

	.blog-card__image {
		aspect-ratio: 16/9;
		position: relative;
		overflow: hidden;
		background: rgba(232, 200, 50, 0.05);
	}

	.blog-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
		opacity: 0.8;
		transition: all 0.7s ease;
	}

	.blog-card:hover .blog-card__image img {
		transform: scale(1.1);
		filter: grayscale(0);
	}

	.blog-card__image-gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, #0a0a0a, transparent);
		pointer-events: none;
	}

	.blog-card__category-badge {
		position: absolute;
		top: 1rem;
		left: 1rem;
		background: var(--brand-gold);
		color: var(--brand-black);
		font-family: var(--font-display);
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		padding: 0.25rem 0.75rem;
		z-index: 1;
	}

	.blog-card__body {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex: 1;
	}

	.blog-card__meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: rgba(240, 237, 232, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.2em;
	}

	.blog-card__title {
		font-family: var(--font-display);
		font-size: 1.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.01em;
		line-height: 1.2;
		transition: color 0.3s ease;
	}

	.blog-card:hover .blog-card__title {
		color: var(--brand-white);
	}

	.blog-card__excerpt {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: rgba(240, 237, 232, 0.6);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.blog-card__link {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		transition: gap 0.3s ease;
		margin-top: auto;
		padding-top: 1rem;
		text-decoration: none;
	}

	.blog-card__link:hover {
		gap: 1.5rem;
	}

	.blog-page__empty {
		max-width: 80rem;
		margin: 0 auto;
		text-align: center;
		padding: 8rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.blog-page__empty h3 {
		font-family: var(--font-display);
		font-size: 2.25rem;
		color: rgba(240, 237, 232, 0.2);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.blog-page__empty p {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: rgba(240, 237, 232, 0.6);
	}

	@media (max-width: 1024px) {
		.blog-page__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.blog-page__grid {
			grid-template-columns: 1fr;
		}

		.blog-page__filters {
			flex-direction: column;
		}
	}
</style>

<script>
	const catBtns = document.querySelectorAll('.blog-page__cat-btn');
	const searchInput = document.getElementById('blogSearch') as HTMLInputElement;
	const cards = document.querySelectorAll('.blog-card');

	let activeCategory = 'Todos';

	catBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			catBtns.forEach(b => b.classList.remove('blog-page__cat-btn--active'));
			btn.classList.add('blog-page__cat-btn--active');
			activeCategory = (btn as HTMLElement).getAttribute('data-category') || 'Todos';
			filterCards();
		});
	});

	searchInput?.addEventListener('input', filterCards);

	function filterCards() {
		const query = (searchInput?.value || '').toLowerCase();
		let visibleCount = 0;

		cards.forEach(card => {
			const cardEl = card as HTMLElement;
			const category = cardEl.getAttribute('data-category') || '';
			const title = cardEl.getAttribute('data-title') || '';
			const body = cardEl.getAttribute('data-body') || '';

			const matchCat = activeCategory === 'Todos' || category === activeCategory;
			const matchSearch = !query || title.includes(query) || body.includes(query);

			if (matchCat && matchSearch) {
				cardEl.style.display = '';
				visibleCount++;
			} else {
				cardEl.style.display = 'none';
			}
		});
	}
</script>
