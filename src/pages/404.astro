---
import Base from "../layouts/Base.astro";
---

<Base title="PowerHouse Gym — 404">
  <main>
    <section class="not-found">
      <div class="not-found__inner">
        <h1 class="not-found__code">404</h1>
        <p class="not-found__text">Pagina no encontrada</p>
        <p class="not-found__sub">La pagina que buscas no existe o fue movida.</p>
        <a class="not-found__link" href="/">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Volver al inicio
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(232, 200, 50, 0.03) 0%, transparent 60%),
      var(--brand-black);
    padding: 2rem;
  }

  .not-found__inner {
    text-align: center;
    max-width: 500px;
  }

  .not-found__code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 700;
    color: var(--brand-gold);
    line-height: 1;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    text-shadow: 0 0 60px rgba(232, 200, 50, 0.15);
  }

  .not-found__text {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    color: var(--brand-white);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .not-found__sub {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: rgba(240, 237, 232, 0.6);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand-gold);
    background: transparent;
    border: 2px solid var(--brand-gold);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .not-found__link:hover {
    background: var(--brand-gold);
    color: var(--brand-black);
    box-shadow: 0 0 20px rgba(232, 200, 50, 0.3);
  }
</style>
