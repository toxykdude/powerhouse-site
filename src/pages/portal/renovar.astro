---
import Base from '../../layouts/Base.astro';
---

<Base title="Renovar Membresía — Portal de Miembros" description="Renueva tu membresía de PowerHouse Gym Manizales. Elige tu plan y paga de forma segura con Wompi.">
	<Fragment slot="head">
		<script is:inline src="https://checkout.wompi.co/widget.js" defer></script>
	</Fragment>

	<div class="renovar-page">
		<!-- HERO — matches planes.astro scale -->
		<div class="renovar-page__hero">
			<a href="/portal/dashboard" class="renovar-page__back">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
				MI CUENTA
			</a>
			<span class="renovar-page__tagline">Renovar Membresía</span>
			<h1>NO PARES<br/>AHORA</h1>
			<p>Tu transformación sigue. Cada día de entrenamiento cuenta. Renueva y continúa forjando tu mejor versión.</p>
		</div>

		<!-- SOCIAL PROOF BAND — urgency hook -->
		<div class="renovar-page__proof">
			<div class="proof-item">
				<span class="proof-item__value">96%</span>
				<span class="proof-item__label">de miembros renuevan</span>
			</div>
			<div class="proof-item__sep"></div>
			<div class="proof-item">
				<span class="proof-item__value">500+</span>
				<span class="proof-item__label">vidas transformadas</span>
			</div>
			<div class="proof-item__sep"></div>
			<div class="proof-item">
				<span class="proof-item__value">10</span>
				<span class="proof-item__label">años forjando campeones</span>
			</div>
		</div>

		<!-- PLAN CARDS — same structure as planes.astro -->
		<div class="renovar-page__plans" id="statePlans">
			<div class="renovar-grid renovar-grid--top" id="plansGridTop"></div>
			<div class="renovar-grid renovar-grid--bottom" id="plansGridBottom"></div>
		</div>

		<!-- TRUST BAR -->
		<div class="renovar-page__trust">
			<div class="trust-item">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
				<div>
					<span class="trust-item__title">PAGO SEGURO</span>
					<span class="trust-item__desc">Tus datos están protegidos con Wompi</span>
				</div>
			</div>
			<div class="trust-item">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
				<div>
					<span class="trust-item__title">SIN PERMANENCIA</span>
					<span class="trust-item__desc">Cancela cuando quieras, sin multas</span>
				</div>
			</div>
			<div class="trust-item">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
				<div>
					<span class="trust-item__title">ACTIVACIÓN INMEDIATA</span>
					<span class="trust-item__desc">Tu plan se activa al instante después del pago</span>
				</div>
			</div>
		</div>

		<!-- CTA BAND — matches main site style -->
		<div class="renovar-page__cta-band">
			<div class="cta-band__bg-text">KEEP THE POWER</div>
			<div class="cta-band__content">
				<h2>¿DUDAS?</h2>
				<p>Escríbenos por WhatsApp y te ayudamos a elegir el plan ideal para ti.</p>
				<a href="https://wa.me/573154711900?text=Hola%20PowerHouse!%20Quiero%20renovar%20mi%20membresía" target="_blank" rel="noopener noreferrer" class="cta-band__btn">
					ESCRIBIR POR WHATSAPP
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
				</a>
			</div>
		</div>

		<!-- SUCCESS STATE -->
		<div class="renovar-state renovar-state--hidden" id="stateSuccess">
			<div class="renovar-success">
				<div class="renovar-success__icon">
					<svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				</div>
				<h2>¡MEMBRESÍA RENOVADA!</h2>
				<p>Tu plan está activo. ¡A entrenar!</p>
				<a href="/portal/dashboard" class="renovar-success__btn">VER MI CUENTA</a>
			</div>
		</div>

		<!-- ERROR STATE -->
		<div class="renovar-state renovar-state--hidden" id="stateError">
			<div class="renovar-error">
				<h2 id="errorTitle">ERROR</h2>
				<p id="errorMessage">No pudimos procesar tu pago. Intenta de nuevo.</p>
				<a href="/portal/dashboard" class="renovar-error__btn">VOLVER</a>
			</div>
		</div>
	</div>
</Base>

<style is:global>
	/* ========== PAGE ========== */
	.renovar-page {
		padding: 8rem 1.5rem 0;
		background: var(--brand-black);
	}

	/* ========== HERO — matches planes.astro ========== */
	.renovar-page__hero {
		text-align: center;
		margin-bottom: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		position: relative;
	}

	.renovar-page__back {
		position: absolute;
		top: 0;
		left: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 1.25rem;
		font-family: var(--font-display);
		font-size: 1rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		text-decoration: none;
		transition: all 0.3s ease;
		border: 1px solid rgba(232, 200, 50, 0.15);
		background: rgba(232, 200, 50, 0.05);
	}

	.renovar-page__back svg {
		transition: transform 0.3s ease;
	}

	.renovar-page__back:hover {
		color: var(--brand-gold);
		border-color: var(--brand-gold);
		background: rgba(232, 200, 50, 0.1);
	}

	.renovar-page__back:hover svg {
		transform: translateX(-3px);
	}

	.renovar-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.renovar-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10vw, 9rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.renovar-page__hero p {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: rgba(240, 237, 232, 0.6);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		max-width: 40rem;
	}

	/* ========== SOCIAL PROOF BAND ========== */
	.renovar-page__proof {
		max-width: 60rem;
		margin: 0 auto 4rem;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;
		padding: 2rem 1.5rem;
		border-top: 1px solid rgba(232, 200, 50, 0.15);
		border-bottom: 1px solid rgba(232, 200, 50, 0.15);
	}

	.proof-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		text-align: center;
	}

	.proof-item__value {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		color: var(--brand-gold);
		line-height: 1;
	}

	.proof-item__label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: rgba(240, 237, 232, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	.proof-item__sep {
		width: 1px;
		height: 3rem;
		background: rgba(232, 200, 50, 0.2);
	}

	/* ========== PLANS GRID — matches planes.astro ========== */
	.renovar-page__plans {
		max-width: 80rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-bottom: 4rem;
	}

	.renovar-grid {
		display: grid;
		gap: 1.5rem;
	}

	.renovar-grid--top {
		grid-template-columns: repeat(3, 1fr);
		max-width: 80rem;
		margin: 0 auto;
		width: 100%;
	}

	.renovar-grid--bottom {
		grid-template-columns: repeat(2, 1fr);
		max-width: 52rem;
		margin: 0 auto;
		width: 100%;
	}

	/* ========== CARDS — premium redesign ========== */
	.renovar-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 2rem 1.75rem;
		border: 1px solid rgba(232, 200, 50, 0.15);
		background: linear-gradient(165deg, #111111 0%, #0a0a0a 100%);
		color: var(--brand-white);
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, border-color 0.4s ease;
		overflow: visible;
	}

	.renovar-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, rgba(232, 200, 50, 0.3), transparent);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.renovar-card:hover {
		transform: translateY(-6px);
		border-color: rgba(232, 200, 50, 0.4);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(232, 200, 50, 0.08);
	}

	.renovar-card:hover::before {
		opacity: 1;
	}

	/* --- FEATURED CARD (Power Pack) --- */
	.renovar-card--featured {
		background: linear-gradient(165deg, #f0d840 0%, #E8C832 40%, #c8a820 100%);
		color: var(--brand-black);
		border-color: var(--brand-gold);
		transform: scale(1.05);
		z-index: 1;
		box-shadow: 0 0 50px rgba(232, 200, 50, 0.2);
		animation: featuredPulse 3s ease-in-out infinite;
	}

	.renovar-card--featured:hover {
		transform: scale(1.05) translateY(-6px);
		border-color: var(--brand-gold);
		box-shadow: 0 20px 60px rgba(232, 200, 50, 0.35), 0 0 80px rgba(232, 200, 50, 0.15);
	}

	.renovar-card--featured::before {
		opacity: 0;
	}

	@keyframes featuredPulse {
		0%, 100% { box-shadow: 0 0 50px rgba(232, 200, 50, 0.2); }
		50% { box-shadow: 0 0 70px rgba(232, 200, 50, 0.35); }
	}

	/* --- ANNUAL CARD --- */
	.renovar-card--annual {
		background: linear-gradient(165deg, #0f0f0f 0%, #080808 100%);
		color: var(--brand-white);
		border: 2px solid var(--brand-gold);
		transform: scale(1.05);
		z-index: 1;
		box-shadow: 0 0 60px rgba(232, 200, 50, 0.15), inset 0 0 30px rgba(232, 200, 50, 0.05);
		animation: annualShimmer 4s ease-in-out infinite;
	}

	.renovar-card--annual:hover {
		transform: scale(1.05) translateY(-6px);
		border-color: white;
		box-shadow: 0 20px 60px rgba(232, 200, 50, 0.25), inset 0 0 40px rgba(232, 200, 50, 0.08);
	}

	@keyframes annualShimmer {
		0%, 100% { border-color: var(--brand-gold); }
		50% { border-color: rgba(255, 255, 255, 0.6); }
	}

	/* --- BADGE --- */
	.renovar-card__badge {
		position: absolute;
		top: -0.9rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--brand-red);
		color: white;
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		padding: 0.3rem 1.25rem;
		white-space: nowrap;
		box-shadow: 0 4px 15px rgba(192, 57, 43, 0.4);
	}

	.renovar-card__badge--gold {
		background: linear-gradient(135deg, #f0d840, #E8C832);
		color: var(--brand-black);
		font-weight: bold;
		box-shadow: 0 4px 15px rgba(232, 200, 50, 0.4);
	}

	/* --- HEADER --- */
	.renovar-card__header {
		margin-bottom: 0;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgba(232, 200, 50, 0.1);
	}

	.renovar-card--featured .renovar-card__header {
		border-bottom-color: rgba(0, 0, 0, 0.15);
	}

	.renovar-card--annual .renovar-card__header {
		border-bottom-color: rgba(232, 200, 50, 0.2);
	}

	.renovar-card__header h3 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		margin-bottom: 0.75rem;
	}

	.renovar-card__price {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
	}

	.renovar-card__currency {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		opacity: 0.5;
	}

	.renovar-card__amount {
		font-family: var(--font-display);
		font-size: 3.25rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.renovar-card__period {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		opacity: 0.5;
	}

	/* --- EQUIVALENT PRICE --- */
	.renovar-card__equivalent {
		display: block;
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		opacity: 0.45;
		letter-spacing: 0.05em;
	}

	.renovar-card--featured .renovar-card__equivalent {
		opacity: 0.6;
	}

	/* --- SAVINGS TAG --- */
	.renovar-card__savings {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.75rem;
		padding: 0.3rem 0.75rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		background: rgba(46, 204, 113, 0.15);
		border: 1px solid rgba(46, 204, 113, 0.3);
		color: #2ecc71;
	}

	.renovar-card--featured .renovar-card__savings {
		background: rgba(0, 0, 0, 0.15);
		border-color: rgba(0, 0, 0, 0.25);
		color: var(--brand-black);
	}

	.renovar-card__savings svg {
		flex-shrink: 0;
	}

	/* --- FEATURES --- */
	.renovar-card__features {
		list-style: none;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem 0;
	}

	.renovar-card__features li {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		line-height: 1.4;
	}

	.renovar-card__features svg {
		flex-shrink: 0;
		margin-top: 3px;
		color: var(--brand-gold);
	}

	.renovar-card--featured .renovar-card__features svg {
		color: var(--brand-black);
	}

	/* --- CTA BUTTONS — premium with arrow --- */
	.renovar-card__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		padding: 1.1rem 1.5rem;
		font-family: var(--font-display);
		font-size: 1.35rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		border: none;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		text-decoration: none;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.renovar-card__cta-arrow {
		display: inline-block;
		transition: transform 0.3s ease;
	}

	.renovar-card__cta:hover .renovar-card__cta-arrow {
		transform: translateX(4px);
	}

	.renovar-card__cta--gold {
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.renovar-card__cta--gold:hover {
		background: white;
		transform: scale(1.02);
		box-shadow: 0 8px 30px rgba(232, 200, 50, 0.3);
	}

	.renovar-card__cta--gold:active {
		transform: scale(0.98);
	}

	.renovar-card__cta--dark {
		background: var(--brand-black);
		color: var(--brand-gold);
		border: 1px solid rgba(232, 200, 50, 0.3);
	}

	.renovar-card__cta--dark:hover {
		background: var(--brand-red);
		color: white;
		border-color: var(--brand-red);
		transform: scale(1.02);
		box-shadow: 0 8px 30px rgba(192, 57, 43, 0.3);
	}

	.renovar-card__cta--dark:active {
		transform: scale(0.98);
	}

	/* Annual card CTA special */
	.renovar-card--annual .renovar-card__cta--gold {
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.renovar-card--annual .renovar-card__cta--gold:hover {
		background: white;
		box-shadow: 0 8px 30px rgba(232, 200, 50, 0.4);
	}

	.renovar-card__cta:disabled {
		opacity: 0.5;
		cursor: not-allowed;
		transform: none !important;
		box-shadow: none !important;
	}

	/* ========== TRUST BAR ========== */
	.renovar-page__trust {
		max-width: 60rem;
		margin: 0 auto 5rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		border-top: 1px solid rgba(232, 200, 50, 0.15);
		padding-top: 2.5rem;
	}

	.trust-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0 0.5rem;
	}

	.trust-item svg {
		color: var(--brand-gold);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.trust-item__title {
		display: block;
		font-family: var(--font-display);
		font-size: 0.85rem;
		color: var(--brand-white);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.2rem;
	}

	.trust-item__desc {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: rgba(240, 237, 232, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		line-height: 1.4;
	}

	/* ========== CTA BAND — matches main site style ========== */
	.renovar-page__cta-band {
		position: relative;
		text-align: center;
		padding: 5rem 1.5rem;
		overflow: hidden;
		border-top: 1px solid rgba(232, 200, 50, 0.3);
	}

	.cta-band__bg-text {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-family: var(--font-display);
		font-size: clamp(4rem, 12vw, 10rem);
		color: rgba(232, 200, 50, 0.04);
		text-transform: uppercase;
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
	}

	.cta-band__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.cta-band__content h2 {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 4rem);
		color: var(--brand-gold);
		text-transform: uppercase;
	}

	.cta-band__content p {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: rgba(240, 237, 232, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		max-width: 30rem;
	}

	.cta-band__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
		padding: 1rem 2.5rem;
		font-family: var(--font-display);
		font-size: 1.125rem;
		text-transform: uppercase;
		text-decoration: none;
		background: var(--brand-gold);
		color: var(--brand-black);
		border: none;
		cursor: pointer;
		transition: background 0.3s ease;
	}

	.cta-band__btn:hover {
		background: white;
	}

	/* ========== STATES ========== */
	.renovar-state {
		max-width: 56rem;
		margin: 0 auto;
	}

	.renovar-state--hidden {
		display: none !important;
	}

	.renovar-success,
	.renovar-error {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		padding: 4rem 2rem;
	}

	.renovar-success__icon {
		color: #2ecc71;
	}

	.renovar-success h2,
	.renovar-error h2 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		color: var(--brand-gold);
		text-transform: uppercase;
	}

	.renovar-success p,
	.renovar-error p {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: rgba(240, 237, 232, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.renovar-success__btn,
	.renovar-error__btn {
		display: inline-block;
		padding: 1rem 2.5rem;
		font-family: var(--font-display);
		font-size: 1.125rem;
		text-transform: uppercase;
		text-decoration: none;
		background: var(--brand-gold);
		color: var(--brand-black);
		border: none;
		cursor: pointer;
		transition: background 0.3s ease;
		margin-top: 1rem;
	}

	.renovar-success__btn:hover,
	.renovar-error__btn:hover {
		background: white;
	}

	/* ========== RESPONSIVE ========== */
	@media (max-width: 768px) {
		.renovar-page {
			padding: 7rem 1rem 0;
		}

		.renovar-page__back {
			position: static;
			align-self: flex-start;
			margin-bottom: 1.5rem;
			font-size: 0.95rem;
			padding: 0.6rem 1rem;
		}

		.renovar-page__hero {
			margin-bottom: 2rem;
		}

		.renovar-page__proof {
			flex-direction: column;
			gap: 1.5rem;
			padding: 1.5rem;
		}

		.proof-item__sep {
			width: 3rem;
			height: 1px;
		}

		.renovar-grid--top,
		.renovar-grid--bottom {
			grid-template-columns: 1fr;
			max-width: 28rem;
		}

		.renovar-card--featured,
		.renovar-card--annual {
			transform: none;
			order: -1;
		}

		.renovar-page__trust {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.cta-band__bg-text {
			font-size: clamp(3rem, 15vw, 6rem);
		}
	}
</style>

<script>
interface Plan {
	wompiId: string;
	facegymId: string;
	name: string;
	amountInCents: number;
	currency: string;
	period: string;
	price: string;
	features: string[];
	badge?: string;
	variant?: 'featured' | 'annual';
	ctaVariant: 'gold' | 'dark';
	equivalent?: string;
	savings?: string;
}

interface SignatureResponse {
	reference: string;
	signature: string;
	amountInCents: number;
	currency: string;
	publicKey: string;
	planName: string;
}

declare global {
	interface Window {
		WidgetCheckout: new (config: {
			currency: string;
			amountInCents: number;
			reference: string;
			publicKey: string;
			signature: { integrity: string };
			redirectUrl?: string;
		}) => {
			open: (callback: (result: { transaction: { id: string } }) => void) => void;
		};
	}
}

const ROW1: Plan[] = [
	{
		wompiId: 'mensual',
		facegymId: '45d96de3-a086-427a-9a8a-44351abb6423',
		name: 'Membresía Mensual',
		amountInCents: 6990000,
		currency: 'COP',
		period: '/mes',
		price: '$69.900',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
		ctaVariant: 'gold',
	},
	{
		wompiId: 'power-pack',
		facegymId: '45d96de3-a086-427a-9a8a-44351abb6423',
		name: 'Power Pack',
		amountInCents: 14000000,
		currency: 'COP',
		period: '/mes',
		price: '$140.000',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual', 'Asesoría en alimentación', 'Servicio de proteína por entreno'],
		badge: 'RECOMENDADO',
		variant: 'featured',
		ctaVariant: 'dark',
	},
	{
		wompiId: 'trimestral',
		facegymId: 'dab31efd-aff9-4554-99d5-40f255af7734',
		name: 'Plan Trimestral',
		amountInCents: 18600000,
		currency: 'COP',
		period: '/trimestre',
		price: '$186.000',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
		ctaVariant: 'gold',
		equivalent: '$62.000/mes',
		savings: 'Ahorras $23.700',
	},
];

const ROW2: Plan[] = [
	{
		wompiId: 'semestral',
		facegymId: '6ec2b4c7-1d89-4625-9402-d78cc22ff4b5',
		name: 'Plan Semestral',
		amountInCents: 36000000,
		currency: 'COP',
		period: '/semestre',
		price: '$360.000',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
		ctaVariant: 'gold',
		equivalent: '$60.000/mes',
		savings: 'Ahorras $59.400',
	},
	{
		wompiId: 'anual',
		facegymId: 'dbf0f5a4-cabb-4c73-991e-3e8b694282bf',
		name: 'Plan Anual',
		amountInCents: 62000000,
		currency: 'COP',
		period: '/año',
		price: '$620.000',
		features: ['Mejor precio beneficio, mes a $51mil!', 'Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
		badge: 'MEJOR VALOR',
		variant: 'annual',
		ctaVariant: 'gold',
		equivalent: '$51.667/mes',
		savings: 'Ahorras $218.800',
	},
];

function showState(stateId: string): void {
	['statePlans', 'stateSuccess', 'stateError'].forEach((id) => {
		const el = document.getElementById(id);
		if (el) el.classList.toggle('renovar-state--hidden', id !== stateId);
	});
}

function getAuthHeaders(): Record<string, string> {
	const t = sessionStorage.getItem('portal_token');
	if (!t) return {};
	return { Authorization: `Bearer ${t}` };
}

const token = sessionStorage.getItem('portal_token');
if (!token) {
	window.location.href = '/portal/';
}

function renderCard(plan: Plan): string {
	const variantClass = plan.variant === 'featured' ? ' renovar-card--featured' : plan.variant === 'annual' ? ' renovar-card--annual' : '';
	const badgeHtml = plan.badge
		? `<div class="renovar-card__badge${plan.variant === 'annual' ? ' renovar-card__badge--gold' : ''}">${plan.badge}</div>`
		: '';

	const equivalentHtml = plan.equivalent
		? `<span class="renovar-card__equivalent">Equivale a ${plan.equivalent}</span>`
		: '';

	const savingsHtml = plan.savings
		? `<div class="renovar-card__savings">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				${plan.savings}
			</div>`
		: '';

	const featuresHtml = plan.features
		.map((f) => `
			<li>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				${f}
			</li>`)
		.join('');

	return `
	<div class="renovar-card${variantClass}" data-plan-id="${plan.wompiId}">
		${badgeHtml}
		<div class="renovar-card__header">
			<h3>${plan.name}</h3>
			<div class="renovar-card__price">
				<span class="renovar-card__currency">${plan.currency}</span>
				<span class="renovar-card__amount">${plan.price}</span>
				<span class="renovar-card__period">${plan.period}</span>
			</div>
			${equivalentHtml}
			${savingsHtml}
		</div>
		<ul class="renovar-card__features">
			${featuresHtml}
		</ul>
		<button type="button" class="renovar-card__cta renovar-card__cta--${plan.ctaVariant}" data-plan-pay="${plan.wompiId}">
			PAGAR AHORA
			<span class="renovar-card__cta-arrow">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
			</span>
		</button>
	</div>`;
}

function wireButtons(): void {
	const allPlans = [...ROW1, ...ROW2];

	document.querySelectorAll<HTMLButtonElement>('[data-plan-pay]').forEach((button) => {
		button.addEventListener('click', async () => {
			const wompiId = button.dataset.planPay;
			if (!wompiId) return;

			const plan = allPlans.find((p) => p.wompiId === wompiId);
			if (!plan) return;

			const originalHtml = button.innerHTML || 'PAGAR AHORA';
			button.disabled = true;
			button.innerHTML = 'PROCESANDO...';

			try {
				const sigResponse = await fetch('/api/payment/signature', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ plan: plan.wompiId }),
				});

				if (!sigResponse.ok) {
					const errData = await sigResponse.json().catch(() => ({}));
					throw new Error(errData.detail || errData.error || 'Error al procesar el pago');
				}

				const sigData: SignatureResponse = await sigResponse.json();

				const WidgetCheckout = window.WidgetCheckout;
				if (!WidgetCheckout) {
					throw new Error('El sistema de pagos no está disponible. Recarga la página e intenta de nuevo.');
				}

				const checkout = new WidgetCheckout({
					currency: sigData.currency,
					amountInCents: sigData.amountInCents,
					reference: sigData.reference,
					publicKey: sigData.publicKey,
					signature: { integrity: sigData.signature },
					redirectUrl: 'https://powerhousegym.co/portal/renovar',
				});

				checkout.open(async (result) => {
					const tx = result.transaction;
					if (tx?.id) {
						try {
							await fetch('/api/portal/renew', {
								method: 'POST',
								headers: {
									'Content-Type': 'application/json',
									...getAuthHeaders(),
								},
								body: JSON.stringify({
									plan_id: plan.facegymId,
									wompi_reference: sigData.reference,
									amount: plan.amountInCents / 100,
								}),
							});
						} catch {
							console.error('FaceGYM renewal call failed after payment');
						}

						showState('stateSuccess');
					} else {
						button.disabled = false;
						button.innerHTML = originalHtml;
					}
				});
			} catch (err) {
				const message = err instanceof Error ? err.message : 'Error desconocido';
				alert(message);
				button.disabled = false;
				button.innerHTML = originalHtml;
			}
		});
	});
}

function renderPlans(): void {
	const topGrid = document.getElementById('plansGridTop');
	const bottomGrid = document.getElementById('plansGridBottom');
	if (!topGrid || !bottomGrid) return;

	topGrid.innerHTML = ROW1.map(renderCard).join('');
	bottomGrid.innerHTML = ROW2.map(renderCard).join('');
	wireButtons();
}

if (token) {
	renderPlans();
}
</script>
