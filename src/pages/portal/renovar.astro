---
import Base from '../../layouts/Base.astro';
---

<Base title="Renovar Membresía — Portal de Miembros" description="Renueva tu membresía de PowerHouse Gym Manizales. Elige tu plan y paga de forma segura con Wompi.">
	<Fragment slot="head">
		<script is:inline src="https://checkout.wompi.co/widget.js" defer></script>
	</Fragment>

	<div class="renovar-page">
		<div class="renovar-page__hero">
			<a href="/portal/dashboard" class="renovar-page__back">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
				MI CUENTA
			</a>
			<span class="renovar-page__tagline">Portal de Miembros</span>
			<h1>RENOVAR<br/>TU PLAN</h1>
			<p>Tu entrenamiento no se detiene. Elige tu plan y sigue forjando tu mejor versión.</p>
		</div>

		<div class="renovar-page__plans" id="statePlans">
			<div class="renovar-grid renovar-grid--top" id="plansGridTop"></div>
			<div class="renovar-grid renovar-grid--bottom" id="plansGridBottom"></div>
		</div>

		<div class="renovar-page__trust">
			<div class="trust-item">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
				<div>
					<span class="trust-item__title">PAGO SEGURO</span>
					<span class="trust-item__desc">Tus datos están protegidos con Wompi</span>
				</div>
			</div>
			<div class="trust-item">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
				<div>
					<span class="trust-item__title">SIN PERMANENCIA</span>
					<span class="trust-item__desc">Cancela cuando quieras, sin multas</span>
				</div>
			</div>
			<div class="trust-item">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
				<div>
					<span class="trust-item__title">ACTIVACIÓN INMEDIATA</span>
					<span class="trust-item__desc">Tu plan se activa al instante después del pago</span>
				</div>
			</div>
		</div>

		<div class="renovar-state renovar-state--hidden" id="stateSuccess">
			<div class="renovar-success">
				<div class="renovar-success__icon">
					<svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				</div>
				<h2>¡MEMBRESÍA RENOVADA!</h2>
				<p>Tu plan está activo. ¡A entrenar!</p>
				<a href="/portal/dashboard" class="renovar-success__btn">VER MI CUENTA</a>
			</div>
		</div>

		<div class="renovar-state renovar-state--hidden" id="stateError">
			<div class="renovar-error">
				<h2 id="errorTitle">ERROR</h2>
				<p id="errorMessage">No pudimos procesar tu pago. Intenta de nuevo.</p>
				<a href="/portal/dashboard" class="renovar-error__btn">VOLVER</a>
			</div>
		</div>
	</div>
</Base>

<style>
	.renovar-page {
		padding: 8rem 1.5rem 6rem;
		background: var(--brand-black);
	}

	.renovar-page__hero {
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		position: relative;
	}

	.renovar-page__back {
		position: absolute;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: rgba(240, 237, 232, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.renovar-page__back:hover {
		color: var(--brand-gold);
	}

	.renovar-page__tagline {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: 0.5em;
	}

	.renovar-page__hero h1 {
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 8vw, 7rem);
		color: var(--brand-gold);
		text-transform: uppercase;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.renovar-page__hero p {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: rgba(240, 237, 232, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		max-width: 40rem;
	}

	.renovar-page__plans {
		max-width: 80rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-bottom: 4rem;
	}

	.renovar-grid {
		display: grid;
		gap: 1.5rem;
	}

	.renovar-grid--top {
		grid-template-columns: repeat(3, 1fr);
		max-width: 80rem;
		margin: 0 auto;
		width: 100%;
	}

	.renovar-grid--bottom {
		grid-template-columns: repeat(2, 1fr);
		max-width: 52rem;
		margin: 0 auto;
		width: 100%;
	}

	/* ---- CARDS ---- */

	.renovar-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 2rem 1.5rem;
		border: 1px solid rgba(232, 200, 50, 0.2);
		background: #0a0a0a;
		color: var(--brand-white);
		transition: all 0.5s ease;
		cursor: pointer;
	}

	.renovar-card:hover {
		border-color: rgba(232, 200, 50, 0.5);
	}

	.renovar-card--featured {
		background: var(--brand-gold);
		color: var(--brand-black);
		border-color: var(--brand-gold);
		transform: scale(1.05);
		z-index: 1;
		box-shadow: 0 0 50px rgba(232, 200, 50, 0.2);
	}

	.renovar-card--featured:hover {
		border-color: var(--brand-gold);
	}

	.renovar-card--annual {
		background: transparent;
		color: var(--brand-white);
		border: 2px solid var(--brand-gold);
		transform: scale(1.05);
		z-index: 1;
		box-shadow: 0 0 60px rgba(232, 200, 50, 0.15), inset 0 0 30px rgba(232, 200, 50, 0.05);
	}

	.renovar-card--annual:hover {
		border-color: white;
		box-shadow: 0 0 80px rgba(232, 200, 50, 0.25), inset 0 0 30px rgba(232, 200, 50, 0.1);
	}

	.renovar-card__badge {
		position: absolute;
		top: -1rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--brand-red);
		color: white;
		font-family: var(--font-display);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		padding: 0.25rem 1rem;
		white-space: nowrap;
	}

	.renovar-card__badge--gold {
		background: var(--brand-gold);
		color: var(--brand-black);
		font-weight: bold;
	}

	.renovar-card__header {
		margin-bottom: 1.5rem;
	}

	.renovar-card__header h3 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		margin-bottom: 0.5rem;
	}

	.renovar-card__price {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
	}

	.renovar-card__currency {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		opacity: 0.6;
	}

	.renovar-card__amount {
		font-family: var(--font-display);
		font-size: 3rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.renovar-card__period {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		opacity: 0.6;
	}

	.renovar-card--featured .renovar-card__currency,
	.renovar-card--featured .renovar-card__period {
		opacity: 0.7;
	}

	.renovar-card__features {
		list-style: none;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.renovar-card__features li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.renovar-card__features svg {
		flex-shrink: 0;
		margin-top: 2px;
		color: var(--brand-gold);
	}

	.renovar-card--featured .renovar-card__features svg {
		color: var(--brand-black);
	}

	.renovar-card__cta {
		display: block;
		width: 100%;
		padding: 1rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		border: none;
		cursor: pointer;
		transition: all 0.3s ease;
		text-decoration: none;
		text-align: center;
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.renovar-card__cta:hover {
		background: white;
	}

	.renovar-card--featured .renovar-card__cta {
		background: var(--brand-black);
		color: var(--brand-gold);
	}

	.renovar-card--featured .renovar-card__cta:hover {
		background: var(--brand-red);
		color: white;
	}

	.renovar-card--annual .renovar-card__cta {
		background: var(--brand-gold);
		color: var(--brand-black);
	}

	.renovar-card--annual .renovar-card__cta:hover {
		background: white;
	}

	.renovar-card__cta:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	/* ---- TRUST BAR ---- */

	.renovar-page__trust {
		max-width: 60rem;
		margin: 0 auto 4rem;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		border-top: 1px solid rgba(232, 200, 50, 0.15);
		padding-top: 2.5rem;
	}

	.trust-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0 0.5rem;
	}

	.trust-item svg {
		color: var(--brand-gold);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.trust-item__title {
		display: block;
		font-family: var(--font-display);
		font-size: 0.85rem;
		color: var(--brand-white);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.2rem;
	}

	.trust-item__desc {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: rgba(240, 237, 232, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		line-height: 1.4;
	}

	/* ---- STATES ---- */

	.renovar-state {
		max-width: 56rem;
		margin: 0 auto;
	}

	.renovar-state--hidden {
		display: none !important;
	}

	.renovar-success,
	.renovar-error {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		padding: 4rem 2rem;
	}

	.renovar-success__icon {
		color: #2ecc71;
	}

	.renovar-success h2,
	.renovar-error h2 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		color: var(--brand-gold);
		text-transform: uppercase;
	}

	.renovar-success p,
	.renovar-error p {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: rgba(240, 237, 232, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.renovar-success__btn,
	.renovar-error__btn {
		display: inline-block;
		padding: 1rem 2.5rem;
		font-family: var(--font-display);
		font-size: 1.125rem;
		text-transform: uppercase;
		text-decoration: none;
		background: var(--brand-gold);
		color: var(--brand-black);
		border: none;
		cursor: pointer;
		transition: background 0.3s ease;
		margin-top: 1rem;
	}

	.renovar-success__btn:hover,
	.renovar-error__btn:hover {
		background: white;
	}

	/* ---- RESPONSIVE ---- */

	@media (max-width: 768px) {
		.renovar-page {
			padding: 7rem 1rem 4rem;
		}

		.renovar-page__back {
			position: static;
			align-self: flex-start;
			margin-bottom: 1rem;
		}

		.renovar-page__hero {
			margin-bottom: 3rem;
		}

		.renovar-grid--top,
		.renovar-grid--bottom {
			grid-template-columns: 1fr;
			max-width: 22rem;
		}

		.renovar-card--featured,
		.renovar-card--annual {
			transform: none;
		}

		.renovar-page__trust {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>

<script>
interface Plan {
	wompiId: string;
	facegymId: string;
	name: string;
	amountInCents: number;
	currency: string;
	period: string;
	price: string;
	features: string[];
	badge?: string;
	variant?: 'featured' | 'annual';
}

interface SignatureResponse {
	reference: string;
	signature: string;
	amountInCents: number;
	currency: string;
	publicKey: string;
	planName: string;
}

declare global {
	interface Window {
		WidgetCheckout: new (config: {
			currency: string;
			amountInCents: number;
			reference: string;
			publicKey: string;
			signature: { integrity: string };
			redirectUrl?: string;
		}) => {
			open: (callback: (result: { transaction: { id: string } }) => void) => void;
		};
	}
}

const ROW1: Plan[] = [
	{
		wompiId: 'mensual',
		facegymId: '45d96de3-a086-427a-9a8a-44351abb6423',
		name: 'Membresía Mensual',
		amountInCents: 6990000,
		currency: 'COP',
		period: '/mes',
		price: '$69.900',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
	},
	{
		wompiId: 'power-pack',
		facegymId: '45d96de3-a086-427a-9a8a-44351abb6423',
		name: 'Power Pack',
		amountInCents: 14000000,
		currency: 'COP',
		period: '/mes',
		price: '$140.000',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual', 'Asesoría en alimentación', 'Servicio de proteína por entreno'],
		badge: 'RECOMENDADO',
		variant: 'featured',
	},
	{
		wompiId: 'trimestral',
		facegymId: 'dab31efd-aff9-4554-99d5-40f255af7734',
		name: 'Plan Trimestral',
		amountInCents: 18600000,
		currency: 'COP',
		period: '/trimestre',
		price: '$186.000',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
	},
];

const ROW2: Plan[] = [
	{
		wompiId: 'semestral',
		facegymId: '6ec2b4c7-1d89-4625-9402-d78cc22ff4b5',
		name: 'Plan Semestral',
		amountInCents: 36000000,
		currency: 'COP',
		period: '/semestre',
		price: '$360.000',
		features: ['Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
	},
	{
		wompiId: 'anual',
		facegymId: 'dbf0f5a4-cabb-4c73-991e-3e8b694282bf',
		name: 'Plan Anual',
		amountInCents: 62000000,
		currency: 'COP',
		period: '/año',
		price: '$620.000',
		features: ['Mejor precio beneficio, mes a $51mil!', 'Asiste todos los días', 'Entrenamiento semipersonalizado', 'Valoración mensual'],
		badge: 'MEJOR VALOR',
		variant: 'annual',
	},
];

function showState(stateId: string): void {
	['statePlans', 'stateSuccess', 'stateError'].forEach((id) => {
		const el = document.getElementById(id);
		if (el) el.classList.toggle('renovar-state--hidden', id !== stateId);
	});
}

function getAuthHeaders(): Record<string, string> {
	const t = sessionStorage.getItem('portal_token');
	if (!t) return {};
	return { Authorization: `Bearer ${t}` };
}

const token = sessionStorage.getItem('portal_token');
if (!token) {
	window.location.href = '/portal/';
}

function renderCard(plan: Plan): string {
	const variantClass = plan.variant === 'featured' ? ' renovar-card--featured' : plan.variant === 'annual' ? ' renovar-card--annual' : '';
	const badgeHtml = plan.badge
		? `<div class="renovar-card__badge${plan.variant === 'annual' ? ' renovar-card__badge--gold' : ''}">${plan.badge}</div>`
		: '';

	const featuresHtml = plan.features
		.map((f) => `
			<li>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				${f}
			</li>`)
		.join('');

	return `
	<div class="renovar-card${variantClass}" data-plan-id="${plan.wompiId}">
		${badgeHtml}
		<div class="renovar-card__header">
			<h3>${plan.name}</h3>
			<div class="renovar-card__price">
				<span class="renovar-card__currency">${plan.currency}</span>
				<span class="renovar-card__amount">${plan.price}</span>
				<span class="renovar-card__period">${plan.period}</span>
			</div>
		</div>
		<ul class="renovar-card__features">
			${featuresHtml}
		</ul>
		<button type="button" class="renovar-card__cta" data-plan-pay="${plan.wompiId}">
			PAGAR AHORA
		</button>
	</div>`;
}

function wireButtons(): void {
	const allPlans = [...ROW1, ...ROW2];

	document.querySelectorAll<HTMLButtonElement>('[data-plan-pay]').forEach((button) => {
		button.addEventListener('click', async () => {
			const wompiId = button.dataset.planPay;
			if (!wompiId) return;

			const plan = allPlans.find((p) => p.wompiId === wompiId);
			if (!plan) return;

			const originalLabel = button.textContent || 'PAGAR AHORA';
			button.disabled = true;
			button.textContent = 'PROCESANDO...';

			try {
				const sigResponse = await fetch('/api/payment/signature', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ plan: plan.wompiId }),
				});

				if (!sigResponse.ok) {
					const errData = await sigResponse.json().catch(() => ({}));
					throw new Error(errData.detail || errData.error || 'Error al procesar el pago');
				}

				const sigData: SignatureResponse = await sigResponse.json();

				const WidgetCheckout = window.WidgetCheckout;
				if (!WidgetCheckout) {
					throw new Error('El sistema de pagos no está disponible. Recarga la página e intenta de nuevo.');
				}

				const checkout = new WidgetCheckout({
					currency: sigData.currency,
					amountInCents: sigData.amountInCents,
					reference: sigData.reference,
					publicKey: sigData.publicKey,
					signature: { integrity: sigData.signature },
					redirectUrl: 'https://powerhousegym.co/portal/renovar',
				});

				checkout.open(async (result) => {
					const tx = result.transaction;
					if (tx?.id) {
						try {
							await fetch('/api/portal/renew', {
								method: 'POST',
								headers: {
									'Content-Type': 'application/json',
									...getAuthHeaders(),
								},
								body: JSON.stringify({
									plan_id: plan.facegymId,
									wompi_reference: sigData.reference,
									amount: plan.amountInCents / 100,
								}),
							});
						} catch {
							console.error('FaceGYM renewal call failed after payment');
						}

						showState('stateSuccess');
					} else {
						button.disabled = false;
						button.textContent = originalLabel;
					}
				});
			} catch (err) {
				const message = err instanceof Error ? err.message : 'Error desconocido';
				alert(message);
				button.disabled = false;
				button.textContent = originalLabel;
			}
		});
	});
}

function renderPlans(): void {
	const topGrid = document.getElementById('plansGridTop');
	const bottomGrid = document.getElementById('plansGridBottom');
	if (!topGrid || !bottomGrid) return;

	topGrid.innerHTML = ROW1.map(renderCard).join('');
	bottomGrid.innerHTML = ROW2.map(renderCard).join('');
	wireButtons();
}

if (token) {
	renderPlans();
}
</script>
