---
interface Props {
  seoTitle?: string;
  title?: string;
  description?: string;
  image?: string;
  articleType?: boolean;
  jsonLd?: string;
}

const {
  seoTitle,
  title,
  description = 'Gimnasio PowerHouse Manizales — Entrenamiento semi-personalizado sin contrato. Lun-Vie 5am-10pm, Sáb-Dom 9am-2pm. Parque de la Mujer, Manizales.',
  image,
  articleType = false,
  jsonLd,
} = Astro.props;

const siteName = 'PowerHouse Gym Manizales';
const canonicalUrl = new URL(Astro.url.pathname, 'https://powerhousegym.co').toString();

// Title logic: seoTitle overrides everything, otherwise compose
let fullTitle: string;
if (seoTitle) {
  fullTitle = seoTitle;
} else if (title) {
  fullTitle = `${title} | ${siteName}`;
} else {
  fullTitle = 'Gimnasio PowerHouse Manizales | Sin Contrato · 5am–10pm';
}

const ogImage = image || 'https://powerhousegym.co/images/og-default.jpg';
const ogType = articleType ? 'article' : 'website';

// BreadcrumbList schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const pageNames: Record<string, string> = {
  'planes': 'Planes y Membresías',
  'nosotros': 'Quiénes Somos',
  'blog': 'Blog',
  'contacto': 'Contacto',
  'terminos': 'Términos y Condiciones',
  'privacidad': 'Política de Privacidad',
};
let breadcrumbLd = '';
if (pathSegments.length > 0) {
  const items = [{ name: 'Inicio', url: 'https://powerhousegym.co' }];
  let currentPath = '';
  for (const seg of pathSegments) {
    currentPath += '/' + seg;
    items.push({ name: pageNames[seg] || seg, url: 'https://powerhousegym.co' + currentPath });
  }
  breadcrumbLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': items.map((item, i) => ({
      '@type': 'ListItem',
      'position': i + 1,
      'name': item.name,
      'item': item.url,
    })),
  });
}
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle} />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="es_CO" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD: LocalBusiness (sitewide) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["HealthClub", "Gym"],
    "name": "PowerHouse Gym Manizales",
    "url": "https://powerhousegym.co",
    "telephone": "+573154711900",
    "email": "gerencia@powerhousegym.co",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Avenida Santander, Parque de la Mujer",
      "addressLocality": "Manizales",
      "addressRegion": "Caldas",
      "addressCountry": "CO"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 5.0649845,
      "longitude": -75.4998569
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "05:00", "closes": "22:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Saturday","Sunday"], "opens": "09:00", "closes": "14:00" }
    ],
    "image": "https://powerhousegym.co/images/og-default.jpg",
    "priceRange": "$$",
    "sameAs": [],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Membresías PowerHouse Gym",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Membresía Mensual" }, "price": "69900", "priceCurrency": "COP" },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Plan Anual" }, "price": "620000", "priceCurrency": "COP" }
      ]
    }
  })} />

  <!-- JSON-LD: WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PowerHouse Gym Manizales",
    "url": "https://powerhousegym.co"
  })} />

  <!-- JSON-LD: BreadcrumbList -->
  {breadcrumbLd && <script type="application/ld+json" set:html={breadcrumbLd} />}

  <!-- JSON-LD: Custom (page-specific) -->
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />

  <style is:global>
    :root {
      --brand-black: #0a0a0a;
      --brand-white: #f0ede8;
      --brand-gold: #e8c832;
      --brand-red: #b91c1c;
      --font-display: 'Bebas Neue', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-mono);
      background: var(--brand-black);
      color: var(--brand-white);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3rem);
      color: var(--brand-gold);
      text-transform: uppercase;
      letter-spacing: -0.01em;
    }
  </style>
</head>
<body>
  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="navbar__inner">
      <a href="/" class="navbar__logo">
        <img src="/images/logo.png" alt="PowerHouse Gym" class="navbar__logo-img" width="68" height="68" />
      </a>
      <div class="navbar__links">
        <a href="/">Inicio</a>
        <a href="/nosotros">Nosotros</a>
        <a href="/planes">Planes</a>
        <a href="/blog">Blog</a>
        <a href="/contacto">Contacto</a>
      </div>
      <a href="/planes#signup-form" class="navbar__cta">INSCRIBIRME</a>
    </div>
  </nav>

  <slot />

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer__inner">
      <div class="footer__brand">
        <img src="/images/logo.png" alt="PowerHouse Gym" class="footer__logo-img" width="52" height="52" />
        <p class="footer__tagline">FORJA TU VERSIÓN MÁS FUERTE</p>
      </div>
      <div class="footer__links">
        <h4>Navegación</h4>
        <a href="/">Inicio</a>
        <a href="/nosotros">Nosotros</a>
        <a href="/planes">Planes</a>
        <a href="/blog">Blog</a>
        <a href="/contacto">Contacto</a>
      </div>
      <div class="footer__links">
        <h4>Legal</h4>
        <a href="/terminos">Términos y Condiciones</a>
        <a href="/privacidad">Política de Privacidad</a>
      </div>
      <div class="footer__links">
        <h4>Contacto</h4>
        <p>Parque de la Mujer, Avenida Santander</p>
        <p>Manizales, Colombia</p>
        <a href="https://wa.me/573154711900">+57 315 471 1900</a>
        <a href="mailto:gerencia@powerhousegym.co">gerencia@powerhousegym.co</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} PowerHouse Gym Manizales. Todos los derechos reservados.</p>
    </div>
  </footer>

  <style>
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(10, 10, 10, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(232, 200, 50, 0.1);
    }
    .navbar__inner {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .navbar__logo { display: flex; align-items: center; }
    .navbar__logo-img { height: 3rem; width: auto; }
    .navbar__links {
      display: flex;
      gap: 2rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
    }
    .navbar__links a { transition: color 0.3s; }
    .navbar__links a:hover { color: var(--brand-gold); }
    .navbar__cta {
      background: var(--brand-gold);
      color: var(--brand-black);
      font-family: var(--font-display);
      font-size: 1.1rem;
      padding: 0.5rem 1.5rem;
      text-transform: uppercase;
      transition: all 0.3s;
    }
    .navbar__cta:hover { background: var(--brand-white); }

    .footer {
      background: #050505;
      border-top: 1px solid rgba(232, 200, 50, 0.1);
      padding: 4rem 1.5rem 0;
    }
    .footer__inner {
      max-width: 80rem;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3rem;
    }
    .footer__tagline {
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--brand-gold);
      margin-top: 1rem;
    }
    .footer__links { display: flex; flex-direction: column; gap: 0.5rem; }
    .footer__links h4 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--brand-gold);
      margin-bottom: 0.5rem;
      text-transform: uppercase;
    }
    .footer__links a, .footer__links p {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: rgba(240, 237, 232, 0.6);
      transition: color 0.3s;
    }
    .footer__links a:hover { color: var(--brand-gold); }
    .footer__logo-img { height: 2.5rem; width: auto; }
    .footer__bottom {
      border-top: 1px solid rgba(232, 200, 50, 0.1);
      padding: 1.5rem 0;
      text-align: center;
    }
    .footer__bottom p {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: rgba(240, 237, 232, 0.3);
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }

    @media (max-width: 768px) {
      .navbar__links { display: none; }
      .navbar__cta { font-size: 0.8rem; padding: 0.4rem 1rem; }
      .footer__inner { grid-template-columns: 1fr; gap: 2rem; }
    }
  </style>
</body>
</html>
