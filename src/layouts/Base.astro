---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	/** Override the full <title> tag completely (skips template logic) */
	seoTitle?: string;
	/** Set og:type to "article" for blog posts */
	articleType?: boolean;
	/** Additional JSON-LD schema to inject (e.g. Article, FAQPage) */
	jsonLd?: string;
}

const {
	title,
	description,
	image,
	seoTitle,
	articleType = false,
	jsonLd,
} = Astro.props;

const siteTitle = "POWERHOUSE";

/**
 * Title tag logic:
 * - If seoTitle is provided, use it verbatim (full control)
 * - If title is provided, format as "[title] | PowerHouse Manizales"
 * - Otherwise fall back to "PowerHouse Gym Manizales | Gimnasio Sin Contrato"
 */
const fullTitle = seoTitle
	|| (title ? `${title} | PowerHouse Manizales` : "Gimnasio PowerHouse Manizales | Sin Contrato · 5am–10pm");

const siteDescription =
	description
	|| "Gimnasio en Manizales sin contrato. Entrenamiento semipersonalizado, equipos de tráfico pesado, 96% de recomendación. Parque de la Mujer, Avenida Santander. ¡Agenda tu clase gratis hoy!";

const defaultOgImage = "https://powerhousegym.co/uploads/Logo%20Arm%20Only%20White%20Neon%20Glow1.png";
const ogImage = image ? (image.startsWith('http') ? image : `${siteDomain}${image}`) : defaultOgImage;
const ogType = articleType ? "article" : "website";

const siteDomain = "https://powerhousegym.co";
const canonicalUrl = new URL(Astro.url.pathname, siteDomain).href;

// BreadcrumbList schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const pageNames: Record<string, string> = {
	'planes': 'Planes y Membresías',
	'nosotros': 'Quiénes Somos',
	'blog': 'Blog',
	'contacto': 'Contacto',
	'terminos': 'Términos y Condiciones',
	'privacidad': 'Política de Privacidad',
};
let breadcrumbLd = '';
if (pathSegments.length > 0) {
	const items = [{ name: 'Inicio', url: 'https://powerhousegym.co' }];
	let currentPath = '';
	for (const seg of pathSegments) {
		currentPath += '/' + seg;
		items.push({ name: pageNames[seg] || seg, url: 'https://powerhousegym.co' + currentPath });
	}
	breadcrumbLd = JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		'itemListElement': items.map((item, i) => ({
			'@type': 'ListItem',
			'position': i + 1,
			'name': item.name,
			'item': item.url,
		})),
	});
}
